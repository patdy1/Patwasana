local Workspace = game:GetService("Workspace")

local function RemoveOnlySurfaceTextures(obj)

	-- ลบ Texture ปกติเท่านั้น
	if obj:IsA("Texture") then
		obj:Destroy()
	end

	-- ไม่แตะ:
	-- Decal
	-- SurfaceAppearance
	-- MeshPart.TextureID
	-- Part.Color
	-- Material

end


-- ทำครั้งแรก
for _, obj in ipairs(Workspace:GetDescendants()) do
	RemoveOnlySurfaceTextures(obj)
end


-- ตรวจของใหม่
Workspace.DescendantAdded:Connect(function(obj)
	RemoveOnlySurfaceTextures(obj)
end)