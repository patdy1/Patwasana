--[[
    ================================================================
    BOWKAO ULTRA FPS BOOST V2
    Production-Ready Client Optimizer
    ================================================================

    CORE RULES
    ----------------------------------------------------------------
    PLAYER CHARACTER
        Protected

    NPC / HUMANOID MODEL
        Protected

    TOOL
        Gameplay protected
        Visual descendants may be optimized

    MAP / ENVIRONMENT / PROPS
        Optimized

    NEVER MODIFIES
        Humanoid
        Character body parts
        Accessories
        Clothing
        CharacterMesh
        BodyColors
        Scripts
        LocalScripts
        ModuleScripts
        RemoteEvents
        RemoteFunctions
        Constraints
        Tool gameplay properties
        CanCollide
        CanTouch
        CanQuery
        Transparency
        Size
        CFrame

    PERFORMANCE DESIGN
        No RenderStepped
        No Heartbeat scanning
        No high-frequency polling
        Event-driven dynamic optimization
        Weak-key caches
        Centralized player connections
        Protection checked before cache
        Duplicate event registration prevented
    ================================================================
]]

----------------------------------------------------------------
-- SERVICES
----------------------------------------------------------------

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer

----------------------------------------------------------------
-- CONFIGURATION
----------------------------------------------------------------

local CONFIG = {

    ------------------------------------------------------------
    -- TEXTURES
    ------------------------------------------------------------

    RemoveTextures = true,
    RemoveDecals = true,
    RemoveSurfaceAppearance = true,

    ------------------------------------------------------------
    -- MAP MATERIAL
    ------------------------------------------------------------

    SimplifyMaterials = true,

    ------------------------------------------------------------
    -- SHADOWS
    ------------------------------------------------------------

    DisableShadows = true,

    ------------------------------------------------------------
    -- EFFECTS
    ------------------------------------------------------------

    DisableParticles = true,
    DisableTrails = true,
    DisableBeams = true,

    DisableSmoke = true,
    DisableFire = true,
    DisableSparkles = true,

    DisableHighlights = true,
    DisableLights = true,

    ------------------------------------------------------------
    -- LIGHTING
    ------------------------------------------------------------

    DisablePostProcessing = true,

    ------------------------------------------------------------
    -- TOOLS
    ------------------------------------------------------------

    OptimizeToolVisuals = true,

    ------------------------------------------------------------
    -- CACHE
    ------------------------------------------------------------

    UseProcessedCache = true,
}

----------------------------------------------------------------
-- INTERNAL STATE
----------------------------------------------------------------

local State = {
    Destroyed = false,
}

----------------------------------------------------------------
-- WEAK CACHES
----------------------------------------------------------------

local Processed = setmetatable({}, {
    __mode = "k",
})

local ProtectedModels = setmetatable({}, {
    __mode = "k",
})

local ProtectedInstances = setmetatable({}, {
    __mode = "k",
})

local PlayerConnections = setmetatable({}, {
    __mode = "k",
})

----------------------------------------------------------------
-- CONNECTION REGISTRY
----------------------------------------------------------------

local Connections = {}

local function Connect(signal, callback)
    local connection = signal:Connect(callback)

    Connections[#Connections + 1] = connection

    return connection
end

local function DisconnectAll()
    for index = #Connections, 1, -1 do

        local connection = Connections[index]

        if connection then
            pcall(function()
                connection:Disconnect()
            end)
        end

        Connections[index] = nil
    end
end

----------------------------------------------------------------
-- SAFE DESTROY CHECK
----------------------------------------------------------------

local function IsAlive(instance)
    return instance ~= nil and instance.Parent ~= nil
end

----------------------------------------------------------------
-- PLAYER CHARACTER DETECTION
----------------------------------------------------------------

local function IsPlayerCharacterModel(model)

    if not model or not model:IsA("Model") then
        return false
    end

    for _, player in ipairs(Players:GetPlayers()) do

        if player.Character == model then
            return true
        end

    end

    return false
end

----------------------------------------------------------------
-- HUMANOID DETECTION
----------------------------------------------------------------

local function HasHumanoid(model)

    if not model or not model:IsA("Model") then
        return false
    end

    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

----------------------------------------------------------------
-- NPC DETECTION
----------------------------------------------------------------

local function IsNPCModel(model)

    if not model or not model:IsA("Model") then
        return false
    end

    if IsPlayerCharacterModel(model) then
        return false
    end

    return HasHumanoid(model)
end

----------------------------------------------------------------
-- REGISTER PROTECTED MODEL
----------------------------------------------------------------

local function RegisterProtectedModel(model)

    if not model or not model:IsA("Model") then
        return
    end

    ProtectedModels[model] = true

    ProtectedInstances[model] = true

    for _, descendant in ipairs(model:GetDescendants()) do
        ProtectedInstances[descendant] = true
    end
end

----------------------------------------------------------------
-- REGISTER CHARACTER
----------------------------------------------------------------

local function RegisterCharacter(character)

    if not character or not character:IsA("Model") then
        return
    end

    ProtectedModels[character] = true
    ProtectedInstances[character] = true

    for _, descendant in ipairs(character:GetDescendants()) do
        ProtectedInstances[descendant] = true
    end
end

----------------------------------------------------------------
-- FIND PROTECTED ANCESTOR
----------------------------------------------------------------

local function FindProtectedModel(instance)

    local current = instance

    while current do

        if current:IsA("Model") then

            --------------------------------------------------------
            -- Cached protected model
            --------------------------------------------------------

            if ProtectedModels[current] then
                return current
            end

            --------------------------------------------------------
            -- Player Character
            --------------------------------------------------------

            if IsPlayerCharacterModel(current) then

                RegisterCharacter(current)

                return current
            end

            --------------------------------------------------------
            -- NPC
            --------------------------------------------------------

            if IsNPCModel(current) then

                RegisterProtectedModel(current)

                return current
            end
        end

        current = current.Parent
    end

    return nil
end

----------------------------------------------------------------
-- TOOL DETECTION
----------------------------------------------------------------

local function FindTool(instance)

    local current = instance

    while current do

        if current:IsA("Tool") then
            return current
        end

        if current == Workspace then
            break
        end

        current = current.Parent
    end

    return nil
end

----------------------------------------------------------------
-- TOOL VISUAL DETECTION
----------------------------------------------------------------

local function IsToolVisual(instance)

    if not CONFIG.OptimizeToolVisuals then
        return false
    end

    local tool = FindTool(instance)

    if not tool then
        return false
    end

    return (
        instance:IsA("Texture")
        or instance:IsA("Decal")
        or instance:IsA("SurfaceAppearance")

        or instance:IsA("ParticleEmitter")
        or instance:IsA("Trail")
        or instance:IsA("Beam")

        or instance:IsA("Smoke")
        or instance:IsA("Fire")
        or instance:IsA("Sparkles")

        or instance:IsA("Highlight")

        or instance:IsA("PointLight")
        or instance:IsA("SpotLight")
        or instance:IsA("SurfaceLight")
    )
end

----------------------------------------------------------------
-- PROTECTION CHECK
----------------------------------------------------------------

local function IsProtected(instance)

    if not instance then
        return true
    end

    ------------------------------------------------------------
    -- Direct cache
    ------------------------------------------------------------

    if ProtectedInstances[instance] then
        return true
    end

    ------------------------------------------------------------
    -- Protected ancestor
    ------------------------------------------------------------

    local protectedModel = FindProtectedModel(instance)

    if protectedModel then
        return true
    end

    return false
end

----------------------------------------------------------------
-- TEXTURE OPTIMIZATION
----------------------------------------------------------------

local function OptimizeTexture(instance)

    ------------------------------------------------------------
    -- Texture
    ------------------------------------------------------------

    if instance:IsA("Texture") then

        if CONFIG.RemoveTextures then
            instance:Destroy()
        end

        return true
    end

    ------------------------------------------------------------
    -- Decal
    ------------------------------------------------------------

    if instance:IsA("Decal") then

        if CONFIG.RemoveDecals then
            instance:Destroy()
        end

        return true
    end

    ------------------------------------------------------------
    -- SurfaceAppearance
    ------------------------------------------------------------

    if instance:IsA("SurfaceAppearance") then

        if CONFIG.RemoveSurfaceAppearance then
            instance:Destroy()
        end

        return true
    end

    return false
end

----------------------------------------------------------------
-- BASEPART OPTIMIZATION
----------------------------------------------------------------

local function OptimizeBasePart(part)

    if not part:IsA("BasePart") then
        return
    end

    ------------------------------------------------------------
    -- MATERIAL
    ------------------------------------------------------------

    if CONFIG.SimplifyMaterials then

        part.Material = Enum.Material.SmoothPlastic
    end

    ------------------------------------------------------------
    -- SHADOW
    ------------------------------------------------------------

    if CONFIG.DisableShadows then

        part.CastShadow = false
    end
end

----------------------------------------------------------------
-- EFFECT OPTIMIZATION
----------------------------------------------------------------

local function OptimizeEffect(instance)

    ------------------------------------------------------------
    -- ParticleEmitter
    ------------------------------------------------------------

    if instance:IsA("ParticleEmitter") then

        if CONFIG.DisableParticles then
            instance.Enabled = false
        end

        return
    end

    ------------------------------------------------------------
    -- Trail
    ------------------------------------------------------------

    if instance:IsA("Trail") then

        if CONFIG.DisableTrails then
            instance.Enabled = false
        end

        return
    end

    ------------------------------------------------------------
    -- Beam
    ------------------------------------------------------------

    if instance:IsA("Beam") then

        if CONFIG.DisableBeams then
            instance.Enabled = false
        end

        return
    end

    ------------------------------------------------------------
    -- Smoke
    ------------------------------------------------------------

    if instance:IsA("Smoke") then

        if CONFIG.DisableSmoke then
            instance.Enabled = false
        end

        return
    end

    ------------------------------------------------------------
    -- Fire
    ------------------------------------------------------------

    if instance:IsA("Fire") then

        if CONFIG.DisableFire then
            instance.Enabled = false
        end

        return
    end

    ------------------------------------------------------------
    -- Sparkles
    ------------------------------------------------------------

    if instance:IsA("Sparkles") then

        if CONFIG.DisableSparkles then
            instance.Enabled = false
        end

        return
    end

    ------------------------------------------------------------
    -- Highlight
    ------------------------------------------------------------

    if instance:IsA("Highlight") then

        if CONFIG.DisableHighlights then
            instance.Enabled = false
        end

        return
    end

    ------------------------------------------------------------
    -- Lights
    ------------------------------------------------------------

    if (
        instance:IsA("PointLight")
        or instance:IsA("SpotLight")
        or instance:IsA("SurfaceLight")
    ) then

        if CONFIG.DisableLights then
            instance.Enabled = false
        end

        return
    end
end

----------------------------------------------------------------
-- SINGLE INSTANCE OPTIMIZER
----------------------------------------------------------------

local function OptimizeInstance(instance)

    if State.Destroyed then
        return
    end

    if not instance then
        return
    end

    if not instance.Parent then
        return
    end

    ------------------------------------------------------------
    -- IMPORTANT:
    -- Protection is checked BEFORE processed cache.
    ------------------------------------------------------------

    local toolVisual = IsToolVisual(instance)

    if not toolVisual then

        if IsProtected(instance) then
            return
        end
    end

    ------------------------------------------------------------
    -- CACHE
    ------------------------------------------------------------

    if CONFIG.UseProcessedCache then

        if Processed[instance] then
            return
        end

        Processed[instance] = true
    end

    ------------------------------------------------------------
    -- TEXTURES
    ------------------------------------------------------------

    if OptimizeTexture(instance) then
        return
    end

    ------------------------------------------------------------
    -- BASEPART
    ------------------------------------------------------------

    if instance:IsA("BasePart") then

        OptimizeBasePart(instance)

        return
    end

    ------------------------------------------------------------
    -- EFFECTS
    ------------------------------------------------------------

    OptimizeEffect(instance)
end

----------------------------------------------------------------
-- ROOT SCAN
----------------------------------------------------------------

local function ScanRoot(root)

    if not root then
        return
    end

    ------------------------------------------------------------
    -- Root
    ------------------------------------------------------------

    OptimizeInstance(root)

    ------------------------------------------------------------
    -- Descendants
    ------------------------------------------------------------

    local descendants = root:GetDescendants()

    for index = 1, #descendants do

        if State.Destroyed then
            break
        end

        local instance = descendants[index]

        OptimizeInstance(instance)
    end
end

----------------------------------------------------------------
-- NPC DISCOVERY
----------------------------------------------------------------

local function RegisterExistingNPCs()

    local descendants = Workspace:GetDescendants()

    for index = 1, #descendants do

        local instance = descendants[index]

        if instance:IsA("Model") then

            if IsNPCModel(instance) then
                RegisterProtectedModel(instance)
            end
        end
    end
end

----------------------------------------------------------------
-- PLAYER MANAGEMENT
----------------------------------------------------------------

local function DisconnectPlayer(player)

    local connections = PlayerConnections[player]

    if not connections then
        return
    end

    for _, connection in ipairs(connections) do

        if connection then

            pcall(function()
                connection:Disconnect()
            end)
        end
    end

    PlayerConnections[player] = nil
end

----------------------------------------------------------------
-- PLAYER SETUP
----------------------------------------------------------------

local function SetupPlayer(player)

    if not player then
        return
    end

    ------------------------------------------------------------
    -- Prevent duplicate setup
    ------------------------------------------------------------

    if PlayerConnections[player] then
        return
    end

    local connections = {}

    PlayerConnections[player] = connections

    ------------------------------------------------------------
    -- CharacterAdded
    ------------------------------------------------------------

    connections[#connections + 1] =
        player.CharacterAdded:Connect(function(character)

            RegisterCharacter(character)

        end)

    ------------------------------------------------------------
    -- Existing character
    ------------------------------------------------------------

    if player.Character then

        RegisterCharacter(player.Character)

    end
end

----------------------------------------------------------------
-- INITIAL PLAYERS
----------------------------------------------------------------

for _, player in ipairs(Players:GetPlayers()) do

    SetupPlayer(player)

end

----------------------------------------------------------------
-- NEW PLAYER
----------------------------------------------------------------

Connect(
    Players.PlayerAdded,
    function(player)

        SetupPlayer(player)

    end
)

----------------------------------------------------------------
-- PLAYER REMOVING
----------------------------------------------------------------

Connect(
    Players.PlayerRemoving,
    function(player)

        if player.Character then
            ProtectedModels[player.Character] = nil
            ProtectedInstances[player.Character] = nil
        end

        DisconnectPlayer(player)

    end
)

----------------------------------------------------------------
-- LIGHTING POST PROCESSING
----------------------------------------------------------------

local function IsPostProcessingEffect(instance)

    return (
        instance:IsA("BloomEffect")
        or instance:IsA("SunRaysEffect")
        or instance:IsA("DepthOfFieldEffect")
        or instance:IsA("BlurEffect")
        or instance:IsA("ColorCorrectionEffect")
    )
end

----------------------------------------------------------------
-- OPTIMIZE LIGHTING
----------------------------------------------------------------

local function OptimizeLighting()

    if not CONFIG.DisablePostProcessing then
        return
    end

    for _, instance in ipairs(Lighting:GetChildren()) do

        if IsPostProcessingEffect(instance) then

            instance.Enabled = false

        end
    end
end

----------------------------------------------------------------
-- DYNAMIC LIGHTING
----------------------------------------------------------------

Connect(
    Lighting.ChildAdded,
    function(instance)

        if not CONFIG.DisablePostProcessing then
            return
        end

        if IsPostProcessingEffect(instance) then

            task.defer(function()

                if instance.Parent then
                    instance.Enabled = false
                end

            end)
        end
    end
)

----------------------------------------------------------------
-- WORLD OBJECT HANDLER
----------------------------------------------------------------

local function HandleWorkspaceInstance(instance)

    if State.Destroyed then
        return
    end

    if not instance or not instance.Parent then
        return
    end

    ------------------------------------------------------------
    -- Model / NPC discovery
    ------------------------------------------------------------

    if instance:IsA("Model") then

        task.defer(function()

            if not instance.Parent then
                return
            end

            if IsNPCModel(instance) then

                RegisterProtectedModel(instance)

                return
            end

            OptimizeInstance(instance)

        end)

        return
    end

    ------------------------------------------------------------
    -- Regular object
    ------------------------------------------------------------

    task.defer(function()

        if instance.Parent then
            OptimizeInstance(instance)
        end

    end)
end

----------------------------------------------------------------
-- SINGLE WORKSPACE EVENT
----------------------------------------------------------------

Connect(
    Workspace.DescendantAdded,
    HandleWorkspaceInstance
)

----------------------------------------------------------------
-- INITIAL NPC REGISTRATION
----------------------------------------------------------------

RegisterExistingNPCs()

----------------------------------------------------------------
-- INITIAL LIGHTING OPTIMIZATION
----------------------------------------------------------------

OptimizeLighting()

----------------------------------------------------------------
-- INITIAL WORLD OPTIMIZATION
----------------------------------------------------------------

ScanRoot(Workspace)

----------------------------------------------------------------
-- EXISTING TOOL VISUALS
----------------------------------------------------------------

local function OptimizeTool(tool)

    if not CONFIG.OptimizeToolVisuals then
        return
    end

    if not tool or not tool:IsA("Tool") then
        return
    end

    for _, descendant in ipairs(tool:GetDescendants()) do

        if IsToolVisual(descendant) then

            OptimizeInstance(descendant)

        end
    end
end

----------------------------------------------------------------
-- INITIAL TOOL SCAN
----------------------------------------------------------------

for _, player in ipairs(Players:GetPlayers()) do

    local character = player.Character

    if character then

        for _, child in ipairs(character:GetChildren()) do

            if child:IsA("Tool") then

                task.defer(function()

                    if child.Parent then
                        OptimizeTool(child)
                    end

                end)

            end
        end
    end
end

----------------------------------------------------------------
-- TOOL DETECTION THROUGH WORKSPACE EVENT
----------------------------------------------------------------

Connect(
    Workspace.DescendantAdded,
    function(instance)

        if not CONFIG.OptimizeToolVisuals then
            return
        end

        if not instance:IsA("Tool") then
            return
        end

        task.defer(function()

            if instance.Parent then
                OptimizeTool(instance)
            end

        end)
    end
)

----------------------------------------------------------------
-- CHARACTER DESCENDANT PROTECTION
--
-- This is an additional safety layer.
----------------------------------------------------------------

local function AttachCharacterProtection(character)

    if not character then
        return
    end

    RegisterCharacter(character)

    local connection = character.DescendantAdded:Connect(function(instance)

        ProtectedInstances[instance] = true

    end)

    Connections[#Connections + 1] = connection
end

----------------------------------------------------------------
-- RE-ATTACH CHARACTER PROTECTION
----------------------------------------------------------------

for _, player in ipairs(Players:GetPlayers()) do

    if player.Character then

        AttachCharacterProtection(player.Character)

    end
end

----------------------------------------------------------------
-- FUTURE CHARACTER PROTECTION
----------------------------------------------------------------

for _, player in ipairs(Players:GetPlayers()) do

    Connect(
        player.CharacterAdded,
        function(character)

            AttachCharacterProtection(character)

        end
    )
end

----------------------------------------------------------------
-- NOTE
--
-- SetupPlayer already handles CharacterAdded.
-- The protection connection above is intentionally lightweight
-- and only records new descendants as protected.
----------------------------------------------------------------

----------------------------------------------------------------
-- CLEANUP
----------------------------------------------------------------

local function Shutdown()

    if State.Destroyed then
        return
    end

    State.Destroyed = true

    DisconnectAll()

    for player in pairs(PlayerConnections) do

        DisconnectPlayer(player)

    end
end

----------------------------------------------------------------
-- SCRIPT CLEANUP WHEN ENVIRONMENT ENDS
----------------------------------------------------------------

script.Destroying:Connect(function()

    Shutdown()

end)

