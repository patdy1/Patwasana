	BackgroundTransparency = 0.10,

	-- Panel
	PanelColor = Color3.fromRGB(46, 48, 51),
	PanelTransparency = 0.08,

	-- Dark Panel
	DarkPanelColor = Color3.fromRGB(25, 27, 29),
	DarkPanelTransparency = 0.08,

	-- Normal Button
	ButtonColor = Color3.fromRGB(55, 57, 60),
	ButtonTransparency = 0.05,

