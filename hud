----------------------------------------------------------------
-- SERVICES
----------------------------------------------------------------

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

----------------------------------------------------------------
-- PLAYER
----------------------------------------------------------------

local Player = Players.LocalPlayer

if not Player then
    return
end

local PlayerGui = Player:WaitForChild("PlayerGui")

----------------------------------------------------------------
-- CONFIG
----------------------------------------------------------------

local CONFIG = {

    ------------------------------------------------------------
    -- GUI
    ------------------------------------------------------------

    GuiName = "PlayerProfileHUD",

    DisplayOrder = 999999,

    Position = UDim2.fromOffset(10, 10),

    BaseSize = Vector2.new(164, 60),

    ------------------------------------------------------------
    -- RESPONSIVE
    ------------------------------------------------------------

    ScaleSmall = 0.84,
    ScaleMedium = 0.92,
    ScaleLarge = 1,

    SmallViewportWidth = 380,
    MediumViewportWidth = 600,

    ------------------------------------------------------------
    -- COLORS
    ------------------------------------------------------------

    BackgroundColor = Color3.fromRGB(35, 37, 39),
    BackgroundTransparency = 0.08,

    PanelColor = Color3.fromRGB(46, 48, 51),
    PanelTransparency = 0.08,

    DarkPanelColor = Color3.fromRGB(25, 27, 29),
    DarkPanelTransparency = 0.04,

    BorderColor = Color3.fromRGB(255, 255, 255),
    BorderTransparency = 0.86,

    MainTextColor = Color3.fromRGB(255, 255, 255),
    SecondaryTextColor = Color3.fromRGB(185, 185, 185),

    ------------------------------------------------------------
    -- BORDER
    ------------------------------------------------------------

    MainCornerRadius = 9,
    PanelCornerRadius = 7,
    AvatarCornerRadius = 7,

    BorderThickness = 1,

    ------------------------------------------------------------
    -- AVATAR
    ------------------------------------------------------------

    AvatarSize = 52,
    AvatarPadding = 4,

    ------------------------------------------------------------
    -- INFORMATION PANEL
    ------------------------------------------------------------

    InfoX = 60,
    InfoPadding = 5,

    ------------------------------------------------------------
    -- TEXT
    ------------------------------------------------------------

    NameTextSize = 11,
    UsernameTextSize = 9,
    DateTextSize = 9,
    TimeTextSize = 9,

    ------------------------------------------------------------
    -- CLOCK
    ------------------------------------------------------------

    ClockInterval = 1,
}

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------

local State = {

    Destroyed = false,

    CurrentCamera = nil,

    CurrentScale = 1,

    ThumbnailLoaded = false,
}

----------------------------------------------------------------
-- CONNECTIONS
----------------------------------------------------------------

local Connections = {}

local function Connect(signal, callback)

    if State.Destroyed then
        return nil
    end

    local connection = signal:Connect(callback)

    Connections[#Connections + 1] = connection

    return connection
end

local function DisconnectAll()

    for index = #Connections, 1, -1 do

        local connection = Connections[index]

        if connection then

            pcall(function()
                connection:Disconnect()
            end)

        end

        Connections[index] = nil
    end
end

----------------------------------------------------------------
-- CLEANUP
----------------------------------------------------------------

local function Cleanup()

    if State.Destroyed then
        return
    end

    State.Destroyed = true

    DisconnectAll()
end

----------------------------------------------------------------
-- REMOVE OLD GUI
----------------------------------------------------------------

local OldGui = PlayerGui:FindFirstChild(CONFIG.GuiName)

if OldGui then

    OldGui:Destroy()

end

----------------------------------------------------------------
-- SCREEN GUI
----------------------------------------------------------------

local Gui = Instance.new("ScreenGui")

Gui.Name = CONFIG.GuiName

Gui.ResetOnSpawn = false

Gui.IgnoreGuiInset = false

Gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

Gui.DisplayOrder = CONFIG.DisplayOrder

Gui.Parent = PlayerGui

----------------------------------------------------------------
-- GUI CLEANUP DETECTION
----------------------------------------------------------------

Connect(
    Gui.Destroying,
    function()

        Cleanup()

    end
)

----------------------------------------------------------------
-- ROUNDING HELPER
----------------------------------------------------------------

local function AddCorner(parent, radius)

    local corner = Instance.new("UICorner")

    corner.Name = "Corner"

    corner.CornerRadius = UDim.new(0, radius)

    corner.Parent = parent

    return corner
end

----------------------------------------------------------------
-- STROKE HELPER
----------------------------------------------------------------

local function AddStroke(parent)

    local stroke = Instance.new("UIStroke")

    stroke.Name = "Border"

    stroke.Color = CONFIG.BorderColor

    stroke.Transparency = CONFIG.BorderTransparency

    stroke.Thickness = CONFIG.BorderThickness

    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    stroke.Parent = parent

    return stroke
end

----------------------------------------------------------------
-- MAIN FRAME
----------------------------------------------------------------

local Main = Instance.new("Frame")

Main.Name = "Main"

Main.Size = UDim2.fromOffset(
    CONFIG.BaseSize.X,
    CONFIG.BaseSize.Y
)

Main.Position = CONFIG.Position

Main.BackgroundColor3 = CONFIG.BackgroundColor

Main.BackgroundTransparency = CONFIG.BackgroundTransparency

Main.BorderSizePixel = 0

Main.ClipsDescendants = true

Main.ZIndex = 10

Main.Parent = Gui

AddCorner(
    Main,
    CONFIG.MainCornerRadius
)

AddStroke(Main)

----------------------------------------------------------------
-- SCALE
----------------------------------------------------------------

local UIScale = Instance.new("UIScale")

UIScale.Name = "ResponsiveScale"

UIScale.Scale = 1

UIScale.Parent = Main

----------------------------------------------------------------
-- AVATAR PANEL
----------------------------------------------------------------

local AvatarPanel = Instance.new("Frame")

AvatarPanel.Name = "AvatarPanel"

AvatarPanel.Size = UDim2.fromOffset(
    CONFIG.AvatarSize,
    CONFIG.AvatarSize
)

AvatarPanel.Position = UDim2.fromOffset(
    CONFIG.AvatarPadding,
    CONFIG.AvatarPadding
)

AvatarPanel.BackgroundColor3 = CONFIG.PanelColor

AvatarPanel.BackgroundTransparency = CONFIG.PanelTransparency

AvatarPanel.BorderSizePixel = 0

AvatarPanel.ClipsDescendants = true

AvatarPanel.ZIndex = 11

AvatarPanel.Parent = Main

AddCorner(
    AvatarPanel,
    CONFIG.PanelCornerRadius
)

----------------------------------------------------------------
-- AVATAR
----------------------------------------------------------------

local Profile = Instance.new("ImageLabel")

Profile.Name = "Avatar"

Profile.Size = UDim2.fromScale(1, 1)

Profile.Position = UDim2.fromOffset(0, 0)

Profile.BackgroundColor3 = CONFIG.DarkPanelColor

Profile.BackgroundTransparency = CONFIG.DarkPanelTransparency

Profile.BorderSizePixel = 0

Profile.Image = ""

Profile.ScaleType = Enum.ScaleType.Crop

Profile.ZIndex = 12

Profile.Parent = AvatarPanel

AddCorner(
    Profile,
    CONFIG.AvatarCornerRadius
)

----------------------------------------------------------------
-- INFORMATION PANEL
----------------------------------------------------------------

local Info = Instance.new("Frame")

Info.Name = "Info"

Info.Size = UDim2.new(
    1,
    -(CONFIG.InfoX + CONFIG.InfoPadding),
    1,
    -(CONFIG.InfoPadding * 2)
)

Info.Position = UDim2.fromOffset(
    CONFIG.InfoX,
    CONFIG.InfoPadding
)

Info.BackgroundColor3 = CONFIG.PanelColor

Info.BackgroundTransparency = CONFIG.PanelTransparency

Info.BorderSizePixel = 0

Info.ClipsDescendants = true

Info.ZIndex = 11

Info.Parent = Main

AddCorner(
    Info,
    CONFIG.PanelCornerRadius
)

----------------------------------------------------------------
-- TEXT CREATOR
----------------------------------------------------------------

local function CreateText(
    name,
    y,
    height,
    textSize,
    color,
    font
)

    local Label = Instance.new("TextLabel")

    Label.Name = name

    Label.Size = UDim2.new(
        1,
        -10,
        0,
        height
    )

    Label.Position = UDim2.fromOffset(
        5,
        y
    )

    Label.BackgroundTransparency = 1

    Label.BorderSizePixel = 0

    Label.Text = ""

    Label.TextColor3 = color

    Label.TextTransparency = 0

    Label.Font = font or Enum.Font.Gotham

    Label.TextSize = textSize

    Label.TextXAlignment = Enum.TextXAlignment.Left

    Label.TextYAlignment = Enum.TextYAlignment.Center

    Label.TextTruncate = Enum.TextTruncate.AtEnd

    Label.RichText = false

    Label.ZIndex = 12

    Label.Parent = Info

    return Label
end

----------------------------------------------------------------
-- TEXT ELEMENTS
----------------------------------------------------------------

local NameText = CreateText(
    "DisplayName",
    1,
    14,
    CONFIG.NameTextSize,
    CONFIG.MainTextColor,
    Enum.Font.GothamBold
)

local UsernameText = CreateText(
    "Username",
    15,
    10,
    CONFIG.UsernameTextSize,
    CONFIG.SecondaryTextColor
)

local DateText = CreateText(
    "Date",
    25,
    10,
    CONFIG.DateTextSize,
    CONFIG.SecondaryTextColor
)

local TimeText = CreateText(
    "Time",
    35,
    10,
    CONFIG.TimeTextSize,
    CONFIG.SecondaryTextColor
)

----------------------------------------------------------------
-- PLAYER DATA
----------------------------------------------------------------

local function UpdatePlayerData()

    if State.Destroyed then
        return
    end

    if not Player.Parent then
        return
    end

    NameText.Text = Player.DisplayName

    UsernameText.Text = "@" .. Player.Name
end

----------------------------------------------------------------
-- DATE / TIME
----------------------------------------------------------------

local function UpdateDateTime()

    if State.Destroyed then
        return
    end

    if not Gui.Parent then
        return
    end

    local Timestamp = os.date("*t")

    if not Timestamp then
        return
    end

    DateText.Text = string.format(
        "%02d/%02d/%04d",
        Timestamp.day,
        Timestamp.month,
        Timestamp.year
    )

    TimeText.Text = string.format(
        "%02d:%02d:%02d",
        Timestamp.hour,
        Timestamp.min,
        Timestamp.sec
    )
end

----------------------------------------------------------------
-- AVATAR
----------------------------------------------------------------

local function LoadAvatar()

    if State.Destroyed then
        return
    end

    local success, image = pcall(function()

        return Players:GetUserThumbnailAsync(
            Player.UserId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size100x100
        )

    end)

    if State.Destroyed then
        return
    end

    if not Gui.Parent then
        return
    end

    if success and image and image ~= "" then

        Profile.Image = image

        State.ThumbnailLoaded = true

    end
end

----------------------------------------------------------------
-- RESPONSIVE SCALE
----------------------------------------------------------------

local function GetResponsiveScale(viewportWidth)

    if viewportWidth <= CONFIG.SmallViewportWidth then

        return CONFIG.ScaleSmall

    elseif viewportWidth <= CONFIG.MediumViewportWidth then

        return CONFIG.ScaleMedium

    end

    return CONFIG.ScaleLarge
end

----------------------------------------------------------------
-- UPDATE RESPONSIVE SCALE
----------------------------------------------------------------

local function UpdateScale()

    if State.Destroyed then
        return
    end

    local Camera = Workspace.CurrentCamera

    if not Camera then
        return
    end

    State.CurrentCamera = Camera

    local ViewportSize = Camera.ViewportSize

    local NewScale = GetResponsiveScale(
        ViewportSize.X
    )

    if math.abs(NewScale - State.CurrentScale) < 0.001 then
        return
    end

    State.CurrentScale = NewScale

    UIScale.Scale = NewScale
end

----------------------------------------------------------------
-- CAMERA BINDING
----------------------------------------------------------------

local CameraViewportConnection = nil

local function BindCamera(Camera)

    if CameraViewportConnection then

        pcall(function()
            CameraViewportConnection:Disconnect()
        end)

        CameraViewportConnection = nil
    end

    State.CurrentCamera = Camera

    if not Camera then
        return
    end

    CameraViewportConnection =
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(
            function()

                UpdateScale()

            end
        )

    UpdateScale()
end

----------------------------------------------------------------
-- CAMERA CHANGE
----------------------------------------------------------------

Connect(
    Workspace:GetPropertyChangedSignal("CurrentCamera"),
    function()

        BindCamera(
            Workspace.CurrentCamera
        )

    end
)

----------------------------------------------------------------
-- INITIAL CAMERA
----------------------------------------------------------------

BindCamera(
    Workspace.CurrentCamera
)

----------------------------------------------------------------
-- PLAYER DATA INITIAL
----------------------------------------------------------------

UpdatePlayerData()

UpdateDateTime()

----------------------------------------------------------------
-- PLAYER DISPLAY NAME CHANGE
----------------------------------------------------------------

Connect(
    Player:GetPropertyChangedSignal("DisplayName"),
    function()

        UpdatePlayerData()

    end
)

----------------------------------------------------------------
-- CLOCK LOOP
----------------------------------------------------------------

task.spawn(function()

    while not State.Destroyed
        and Gui.Parent
    do

        UpdateDateTime()

        task.wait(CONFIG.ClockInterval)

    end

end)

----------------------------------------------------------------
-- AVATAR LOADING
----------------------------------------------------------------

task.spawn(function()

    LoadAvatar()

end)

----------------------------------------------------------------
-- FINAL SAFETY
----------------------------------------------------------------

Connect(
    Player.AncestryChanged,
    function(_, parent)

        if not parent then

            Cleanup()

        end

    end
)

----------------------------------------------------------------
-- READY
----------------------------------------------------------------

print("[PlayerProfileHUD V2] Initialized")