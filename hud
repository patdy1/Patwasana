--==================================================
-- REMOVE OLD GUI
--==================================================

local oldGui = playerGui:FindFirstChild(CONFIG.GuiName)

if oldGui then
	oldGui:Destroy()
end

--==================================================
-- SCREEN GUI
--==================================================

local gui = Instance.new("ScreenGui")

gui.Name = CONFIG.GuiName

-- ไม่หายตอนเกิดใหม่
gui.ResetOnSpawn = false

-- ใช้พื้นที่ ScreenGui ปกติ
gui.IgnoreGuiInset = false

-- ให้ ZIndex ทำงานเป็นชั้น
gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

-- อยู่บนสุดของ ScreenGui อื่น
gui.DisplayOrder = 999999

gui.Parent = playerGui

--==================================================
-- ROUND FUNCTION
--==================================================

local function makeRounded(instance, radius)

	local corner = Instance.new("UICorner")

	corner.Name = "Corner"
	corner.CornerRadius = UDim.new(0, radius)

	corner.Parent = instance

	return corner

end

--==================================================
-- MAIN FRAME
--==================================================

local main = Instance.new("Frame")

main.Name = "Main"

main.Size = CONFIG.Size
main.Position = CONFIG.Position

main.BackgroundColor3 = CONFIG.BackgroundColor
main.BackgroundTransparency = CONFIG.BackgroundTransparency

main.BorderSizePixel = 0

-- Top layer
main.ZIndex = 1000000

main.Parent = gui

-- Rounded
makeRounded(
	main,
	CONFIG.MainCornerRadius
)

--==================================================
-- MAIN BORDER
--==================================================

local mainStroke = Instance.new("UIStroke")

