--==================================================
-- TEXT CREATOR
--==================================================

local function createText(
	name,
	y,
	color,
	transparency
)

	local label = Instance.new("TextLabel")

	label.Name = name

	label.Size = UDim2.new(
		1,
		-8,
		0,
		11
	)

	label.Position = UDim2.fromOffset(
		4,
		y
	)

	label.BackgroundTransparency = 1

	label.BorderSizePixel = 0

	label.TextColor3 = color
	label.TextTransparency = transparency

	label.Font = CONFIG.Font
	label.TextSize = CONFIG.TextSize

	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center

	label.TextTruncate = Enum.TextTruncate.AtEnd

	label.RichText = false

	label.ZIndex = 1000002

	label.Parent = info

	return label

end

--==================================================
-- TEXT ELEMENTS
--==================================================

local nameText = createText(
	"DisplayName",
	0,
	CONFIG.TextColor,
	CONFIG.TextTransparency
)

local userText = createText(
	"Username",
	12,
	CONFIG.SecondaryTextColor,
	CONFIG.SecondaryTextTransparency
)

local dateText = createText(
	"Date",
	24,
	CONFIG.SecondaryTextColor,
	CONFIG.SecondaryTextTransparency
)

local timeText = createText(
	"Time",
	36,
	CONFIG.SecondaryTextColor,
	CONFIG.SecondaryTextTransparency
)

--==================================================
-- PLAYER INFORMATION
--==================================================

nameText.Text = player.DisplayName

userText.Text = "@" .. player.Name

--==================================================
-- AVATAR LOADING
--==================================================

task.spawn(function()

	local success, image = pcall(function()

		return Players:GetUserThumbnailAsync(
			player.UserId,
			Enum.ThumbnailType.HeadShot,
			Enum.ThumbnailSize.Size100x100
		)

	end)

	if success and image then

		profile.Image = image

	end

end)

--==================================================
-- DATE / TIME
--==================================================

local function updateDateTime()

	local t = os.date("*t")

	dateText.Text = string.format(
		"%02d/%02d/%04d",
		t.day,
		t.month,
		t.year
	)

	timeText.Text = string.format(
		"%02d:%02d:%02d",
		t.hour,
		t.min,
		t.sec
	)

end

--==================================================
-- INITIAL UPDATE
--==================================================

updateDateTime()

--==================================================
-- REAL-TIME CLOCK
--==================================================

task.spawn(function()

	while gui.Parent do

		updateDateTime()

		task.wait(1)

	end

end)