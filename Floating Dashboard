--==================================================
-- PING COLOR SYSTEM
--==================================================

local function getPingColor(ping)

	if ping <= 50 then
		return Color3.fromRGB(100, 255, 130), "EXCELLENT"
	elseif ping <= 100 then
		return Color3.fromRGB(255, 220, 80), "GOOD"
	elseif ping <= 200 then
		return Color3.fromRGB(255, 155, 70), "HIGH"
	else
		return Color3.fromRGB(255, 80, 80), "VERY HIGH"
	end

end

--==================================================
-- GET PING
--==================================================

local function getPing()

	local success, result = pcall(function()
		local network = Stats.Network
		local serverStats = network.ServerStatsItem
		local pingItem =
			serverStats:FindFirstChild("Data Ping")
		if pingItem then
			local value = pingItem:GetValue()
			if typeof(value) == "number" then
				return math.floor(value)
			end
		end
		return nil
	end)
	if success then
		return result
	end
	return nil
end

--==================================================
-- FPS
--==================================================

local fps = 60
local frameCounter = 0
local fpsTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)

	frameCounter += 1
	fpsTimer += deltaTime
	if fpsTimer >= 0.5 then
		fps = math.floor(
			frameCounter / fpsTimer + 0.5
		)
		frameCounter = 0
		fpsTimer = 0
	end

end)

--==================================================
-- REAL-TIME UPDATE
--==================================================

task.spawn(function()

	while ScreenGui.Parent do
		-- Ping
		local ping = getPing()
		if ping then
			local color, status = getPingColor(ping)
			PingValue.Text = tostring(ping) .. " ms"
			PingValue.TextColor3 = color
			StatusDot.BackgroundColor3 = color
		else
			PingValue.Text = "-- ms"
			PingValue.TextColor3 = CONFIG.TextColor
			StatusDot.BackgroundColor3 =
				Color3.fromRGB(180, 180, 180)
		end
		-- FPS
		FPSValue.Text = tostring(fps)
		if fps >= 55 then
			FPSValue.TextColor3 =
				Color3.fromRGB(100, 255, 130)
		elseif fps >= 30 then
			FPSValue.TextColor3 =
				Color3.fromRGB(255, 220, 80)
		else
			FPSValue.TextColor3 =
				Color3.fromRGB(255, 80, 80)
		end
		-- Players
		local playerCount = #Players:GetPlayers()
		PlayersValue.Text =
			tostring(playerCount) .. " / " ..
			tostring(Players.MaxPlayers)
		-- Server
		if game:IsLoaded() then
			ConnectionValue.Text = "CONNECTED"
			ConnectionValue.TextColor3 =
				Color3.fromRGB(100, 255, 130)
			StatusText.Text = "SERVER CONNECTED"
		else
			ConnectionValue.Text = "CONNECTING"
			ConnectionValue.TextColor3 =
				Color3.fromRGB(255, 220, 80)
			StatusText.Text = "CONNECTING..."
		end
		task.wait(CONFIG.UpdateRate)
	end

end)

