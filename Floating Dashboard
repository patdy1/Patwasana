--//==================================================
--// COLLAPSE
--//==================================================

local function setCollapsed(
	value
)

	if State.Destroyed then
		return
	end

	if State.Collapsed == value then
		return
	end

	State.Collapsed =
		value

	AnimationToken += 1

	local token =
		AnimationToken

	if value then

		Collapse.Text = "+"

		Content.Visible = false
		Footer.Visible = false

		local tween =
			playTween(
				Main,
				{
					Size =
						UDim2.fromOffset(
							CONFIG.Width,
							CONFIG.CollapsedHeight
						)
				},
				CONFIG.CollapseTweenTime
			)

		waitForTween(
			tween,
			function()

				if token
					~= AnimationToken
					or not State.Collapsed then

					return
				end

				clampCurrentPosition()
			end
		)

	else

		Collapse.Text = "—"

		local tween =
			playTween(
				Main,
				{
					Size =
						UDim2.fromOffset(
							CONFIG.Width,
							CONFIG.Height
						)
				},
				CONFIG.CollapseTweenTime
			)

		waitForTween(
			tween,
			function()

				if token
					~= AnimationToken
					or State.Collapsed then

					return
				end

				if not ScreenGui.Parent then
					return
				end

				Content.Visible = true
				Footer.Visible = true

				clampCurrentPosition()
			end
		)
	end
end

