--==============================================================
-- INITIALIZATION
--==============================================================

bindCamera(
	workspace.CurrentCamera
)

updateUsernameDisplay()

updateContentCanvasSize()

updatePlayers()

updateDashboard()

updateScale()

updateScrollIndicator()

task.defer(function()
	if State.Destroyed then
		return
	end

	if not ScreenGui.Parent then
		return
	end

	local viewport =
		getViewportSize()

	if viewport.X > 0
		and viewport.Y > 0
	then
		centerDashboard()
		clampCurrentPosition()
	end

	updateContentCanvasSize()
	updateScrollIndicator()
end)

--==============================================================
-- DASHBOARD UPDATE LOOP
--==============================================================

task.spawn(function()
	State.UpdateRunning = true

	while not State.Destroyed do
		if not ScreenGui.Parent then
			break
		end

		local success =
			pcall(updateDashboard)

		if not success then
			-- Protected intentionally.
			-- Dashboard monitoring must not terminate
			-- the entire lifecycle if a transient Roblox
			-- API error occurs.
		end

		task.wait(
			CONFIG.UpdateRate
		)
	end

	State.UpdateRunning = false
end)