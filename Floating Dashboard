local function updateContentCanvasSize()
	if State.Destroyed then
		return
	end

	if not Content
		or not Content.Parent
	then
		return
	end

	local requiredWidth =
		Content.AbsoluteSize.X

	local requiredHeight =
		LAYOUT.ContentHeight

	for _, child in ipairs(Content:GetChildren()) do
		if child:IsA("GuiObject")
			and child ~= ScrollIndicator
			and child.Visible
		then
			local bottom =
				child.Position.Y.Offset
				+ child.AbsoluteSize.Y

			requiredHeight =
				math.max(
					requiredHeight,
					bottom
				)
		end
	end

	Content.CanvasSize =
		UDim2.fromOffset(
			math.max(requiredWidth, 0),
			math.max(requiredHeight, 0)
		)

	queueScrollIndicatorUpdate()
end

