local function getPingState(ping)
	if ping <= 50 then
		return CONFIG.GoodColor, "EXCELLENT"
	elseif ping <= 100 then
		return CONFIG.WarningColor, "GOOD"
	elseif ping <= 200 then
		return CONFIG.HighColor, "HIGH"
	else
		return CONFIG.BadColor, "VERY HIGH"
	end
end

local function getPing()
	local success, seconds = pcall(function()
		return Player:GetNetworkPing()
	end)

	if not success then
		return nil
	end

	if typeof(seconds) ~= "number" then
		return nil
	end

	if seconds < 0 then
		return nil
	end

	return math.floor(seconds * 1000 + 0.5)
end

local function updateFPS(deltaTime)
	if State.Destroyed then
		return
	end

	State.FrameCounter += 1
	State.FPSTimer += math.clamp(deltaTime, 0, 1)

	if State.FPSTimer >= CONFIG.FPSSampleRate then
		State.FPS = math.max(
			1,
			math.floor(
				State.FrameCounter / State.FPSTimer + 0.5
			)
		)

		State.FrameCounter = 0
		State.FPSTimer = 0
	end
end

local function getFPSColor(value)
	if value >= 55 then
		return CONFIG.GoodColor
	elseif value >= 30 then
		return CONFIG.WarningColor
	else
		return CONFIG.BadColor
	end
end

local function updatePing(ping)
	if ping == State.LastPing then
		return
	end

	State.LastPing = ping

	if ping then
		local color, status = getPingState(ping)

		PingValue.Text = string.format("%d ms", ping)
		PingValue.TextColor3 = color

		StatusDot.BackgroundColor3 = color

		StatusText.Text = string.format(
			"CONNECTED  •  %d ms  •  %s",
			ping,
			status
		)

		StatusText.TextColor3 = color

		ConnectionValue.Text = "CONNECTED"
		ConnectionValue.TextColor3 = CONFIG.GoodColor
	else
		PingValue.Text = "-- ms"
		PingValue.TextColor3 = CONFIG.TextColor

		StatusDot.BackgroundColor3 = CONFIG.NeutralColor

		StatusText.Text = "NETWORK UNAVAILABLE"
		StatusText.TextColor3 = CONFIG.SecondaryTextColor

		ConnectionValue.Text = "UNAVAILABLE"
		ConnectionValue.TextColor3 = CONFIG.NeutralColor
	end
end

local function updateFPSUI()
	if State.FPS == State.LastFPS then
		return
	end

	State.LastFPS = State.FPS

	if not State.FPS then
		FPSValue.Text = "--"
		FPSValue.TextColor3 = CONFIG.TextColor
		return
	end

	FPSValue.Text = tostring(State.FPS)
	FPSValue.TextColor3 = getFPSColor(State.FPS)
end

local function updatePlayers()
	local count = #Players:GetPlayers()
	local maxPlayers = Players.MaxPlayers

	if count == State.LastPlayerCount
		and maxPlayers == State.LastMaxPlayers then
		return
	end

	State.LastPlayerCount = count
	State.LastMaxPlayers = maxPlayers

	PlayersValue.Text = string.format(
		"%d / %d",
		count,
		maxPlayers
	)
end

local function updateDashboard()
	if State.Destroyed then
		return
	end

	if not ScreenGui.Parent then
		return
	end

	updatePing(getPing())
	updateFPSUI()
	updatePlayers()
end

local function setupButton(button)
	local function setColor(color)
		if State.Destroyed then
			return
		end

		playTween(
			button,
			{
				BackgroundColor3 = color
			},
			CONFIG.TweenTime
		)
	end

	connect(
		button.MouseEnter,
		function()
			if ButtonPressedState[button] then
				return
			end

			setColor(CONFIG.HoverColor)
		end
	)

	connect(
		button.MouseLeave,
		function()
			if ButtonPressedState[button] then
				return
			end

			setColor(CONFIG.ButtonColor)
		end
	)

	connect(
		button.InputBegan,
		function(input)
			local inputType = input.UserInputType

			if inputType == Enum.UserInputType.MouseButton1
				or inputType == Enum.UserInputType.Touch then

				ButtonPressedState[button] = true
				setColor(CONFIG.PressedColor)
			end
		end
	)

	connect(
		button.InputEnded,
		function(input)
			local inputType = input.UserInputType

			if inputType == Enum.UserInputType.MouseButton1
				or inputType == Enum.UserInputType.Touch then

				ButtonPressedState[button] = nil
				setColor(CONFIG.ButtonColor)
			end
		end
	)
end

