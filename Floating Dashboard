	State.ConfirmVisible = value
	ConfirmOverlay.Visible = value

	Main.Interactable = not value
	ReopenButton.Interactable = not value

	if value then
		ConfirmBox.Position = UDim2.fromScale(0.5, 0.5)
	end
end

local function setCollapsed(value)
	if State.Destroyed then
		return
	end

	if State.Collapsed == value then
		return
	end

	State.Collapsed = value
	AnimationToken += 1

	local currentToken = AnimationToken

	if value then
		Content.Visible = false
		Collapse.Text = "+"

		local tween = playTween(
			Main,
			{
				Size = UDim2.fromOffset(
					CONFIG.Width,
					CONFIG.CollapsedHeight
				)
			},
			CONFIG.CollapseTweenTime
		)

		if tween then
			connect(
				tween.Completed,
				function()
					if State.Destroyed then
						return
					end

					if currentToken ~= AnimationToken then
						return
					end

					clampCurrentPosition()
				end
			)
		end
	else
		Collapse.Text = "—"

		local tween = playTween(
			Main,
			{
				Size = UDim2.fromOffset(
					CONFIG.Width,
					CONFIG.Height
				)
			},
			CONFIG.CollapseTweenTime
		)

		if tween then
			connect(
				tween.Completed,
				function()
					if State.Destroyed then
						return
					end

					if currentToken ~= AnimationToken then
						return
					end

					if State.Collapsed then
						return
					end

					if not ScreenGui.Parent then
						return
					end

					Content.Visible = true
					clampCurrentPosition()
				end
			)
		end
	end
end

local function showDashboard()
	if State.Destroyed then
		return
	end

	State.DashboardVisible = true
	Main.Visible = true
	ReopenButton.Visible = false

	clampCurrentPosition()
	updateScale()
end

local function hideDashboard()
	if State.Destroyed then
		return
	end

	State.DashboardVisible = false
	State.Dragging = false
	State.DragStart = nil
	State.StartPosition = nil
	State.DragInput = nil

	Main.Visible = false
	ConfirmOverlay.Visible = false
	State.ConfirmVisible = false

	if CONFIG.ReopenEnabled then
		ReopenButton.Position = Main.Position
		ReopenButton.Visible = true
	else
		cleanup()

		if ScreenGui.Parent then
			ScreenGui:Destroy()
		end
	end
end

connect(
	Collapse.Activated,
	function()
		if State.ConfirmVisible then
			return
		end

		setCollapsed(not State.Collapsed)
	end
)

connect(
	Close.Activated,
	function()
		if State.Destroyed then
			return
		end

		setConfirmVisible(true)
	end
)

connect(
	Cancel.Activated,
	function()
		setConfirmVisible(false)
	end
)

connect(
	Confirm.Activated,
	function()
		setConfirmVisible(false)
		hideDashboard()
	end
)

connect(
	ReopenButton.Activated,
	function()
		showDashboard()
	end
)

connect(
	DragArea.InputBegan,
	beginDrag
)

connect(
	DragArea.InputChanged,
	function(input)
		local inputType = input.UserInputType

		if inputType == Enum.UserInputType.MouseMovement
			or inputType == Enum.UserInputType.Touch then

			State.DragInput = input
		end
	end
)

connect(
	UserInputService.InputChanged,
	function(input)
		if State.Destroyed then
			return
		end

		if not State.Dragging then
			return
		end

		local inputType = input.UserInputType

		if inputType == Enum.UserInputType.MouseMovement
			or inputType == Enum.UserInputType.Touch then

			updateDrag(input)
		end
	end
)

connect(
	UserInputService.InputEnded,
	function(input)
		endDrag(input)
	end
)

connect(
	workspace:GetPropertyChangedSignal("CurrentCamera"),
	function()
		if State.Destroyed then
			return
		end

		bindCamera(workspace.CurrentCamera)
	end
)

connect(
	ScreenGui:GetPropertyChangedSignal("AbsoluteSize"),
	function()
		if State.Destroyed then
			return
		end

		updateScale()
	end
)

connect(
	Players.PlayerAdded,
	function()
		updatePlayers()
	end
)

connect(
	Players.PlayerRemoving,
	function()
		task.defer(updatePlayers)
	end
)

connect(
	RunService.PreRender,
	updateFPS
)

local destroyingConnection = ScreenGui.Destroying:Connect(
	function()
		cleanup()
	end
)

table.insert(
	Connections,
	destroyingConnection
)

bindCamera(workspace.CurrentCamera)

task.spawn(
	function()
		while not State.Destroyed and ScreenGui.Parent do
			updateDashboard()
			task.wait(CONFIG.UpdateRate)
		end
	end
)

updatePlayers()
updateDashboard()
updateScale()

task.defer(
	function()
		if State.Destroyed then
			return
		end

		if not ScreenGui.Parent then
			return
		end

		clampCurrentPosition()
	end
)