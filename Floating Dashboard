	disconnectAll()

	table.clear(ButtonPressedState)
end

local function getViewportSize()
	local size = ScreenGui.AbsoluteSize

	if size.X > 0 and size.Y > 0 then
		return size
	end

	local camera = workspace.CurrentCamera

	if camera then
		return camera.ViewportSize
	end

	return Vector2.new(0, 0)
end

local function clampPosition(position)
	local viewport = getViewportSize()
	local renderedSize = Main.AbsoluteSize
	local padding = CONFIG.ScreenPadding

	local maxX = math.max(
		padding,
		viewport.X - renderedSize.X - padding
	)

	local maxY = math.max(
		padding,
		viewport.Y - renderedSize.Y - padding
	)

	return UDim2.fromOffset(
		math.clamp(
			position.X.Offset,
			padding,
			maxX
		),
		math.clamp(
			position.Y.Offset,
			padding,
			maxY
		)
	)
end

local function clampCurrentPosition()
	if State.Destroyed then
		return
	end

	Main.Position = clampPosition(Main.Position)

	if ReopenButton.Visible then
		ReopenButton.Position = Main.Position
	end
end

local function beginDrag(input)
	if State.Destroyed then
		return
	end

	if State.ConfirmVisible then
		return
	end

	if not Main.Visible then
		return
	end

	local inputType = input.UserInputType

	if inputType ~= Enum.UserInputType.MouseButton1
		and inputType ~= Enum.UserInputType.Touch then
		return
	end

	State.Dragging = true
	State.DragStart = input.Position
	State.StartPosition = Main.Position
	State.DragInput = nil
end

local function updateDrag(input)
	if not State.Dragging then
		return
	end

	if State.Destroyed then
		return
	end

	if not State.DragStart or not State.StartPosition then
		return
	end

	local delta = input.Position - State.DragStart

	local newPosition = UDim2.fromOffset(
		State.StartPosition.X.Offset + delta.X,
		State.StartPosition.Y.Offset + delta.Y
	)

	Main.Position = clampPosition(newPosition)
end

local function endDrag(input)
	if not State.Dragging then
		return
	end

	local inputType = input.UserInputType

	if inputType == Enum.UserInputType.MouseButton1
		or inputType == Enum.UserInputType.Touch then

		State.Dragging = false
		State.DragStart = nil
		State.StartPosition = nil
		State.DragInput = nil

		clampCurrentPosition()
	end
end

local function getResponsiveScale(viewportWidth)
	if viewportWidth <= 380 then
		return CONFIG.MobileScale
	elseif viewportWidth <= 500 then
		return CONFIG.SmallScale
	elseif viewportWidth <= 800 then
		return CONFIG.TabletScale
	else
		return CONFIG.DesktopScale
	end
end

local function updateScale()
	if State.Destroyed then
		return
	end

	local viewport = getViewportSize()

	if viewport.X <= 0 then
		return
	end

	local targetScale = getResponsiveScale(viewport.X)

	if math.abs(UIScale.Scale - targetScale) > 0.001 then
		UIScale.Scale = targetScale
	end

	clampCurrentPosition()
end

local function bindCamera(camera)
	if State.Destroyed then
		return
	end

	disconnectCameraViewport()

	State.CurrentCamera = camera

	if not camera then
		updateScale()
		return
	end

	CameraViewportConnection = camera:GetPropertyChangedSignal(
		"ViewportSize"
	):Connect(function()
		if State.Destroyed then
			return
		end

		updateScale()
	end)

	updateScale()
end

local function setConfirmVisible(value)
	if State.Destroyed then
		return
