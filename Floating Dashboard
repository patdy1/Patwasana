				return
			end

			playTween(
				button,
				{
					BackgroundColor3 =
						CONFIG.ButtonColor
				}
			)
		end
	)

	connect(
		button.MouseButton1Down,
		function()
			if State.Destroyed then
				return
			end

			playTween(
				button,
				{
					BackgroundColor3 =
						CONFIG.PressedColor
				}
			)
		end
	)

	connect(
		button.MouseButton1Up,
