local function updateUsernameDisplay()
	if State.Destroyed then
		return
	end

	if not Title or not Title.Parent then
		return
	end

	local username = Player.Name

	if typeof(username) ~= "string"
		or username == ""
	then
		username = "PLAYER"
	end

	Title.Text = username

	Title.Size =
		UDim2.new(
			1,
			-6,
			0,
			18
		)

	Title.Position =
		UDim2.fromOffset(
			2,
			5
		)

	Title.TextXAlignment =
		Enum.TextXAlignment.Left

	Title.TextTruncate =
		Enum.TextTruncate.AtEnd

	Title.Font =
		Enum.Font.GothamBold

	-- The title width is derived from the existing header geometry.
	local headerWidth =
		CONFIG.Width
		- (CONFIG.OuterPadding * 2)

	local dragWidth =
		headerWidth - 138

	local titleWidth =
		math.max(
			1,
			dragWidth - 6
		)

	local selectedSize =
		CONFIG.UsernameMinTextSize

	for textSize =
		CONFIG.UsernameMaxTextSize,
		CONFIG.UsernameMinTextSize,
		-1
	do
		local success, bounds =
			pcall(function()
				return TextService:GetTextSize(
					username,
					textSize,
					Enum.Font.GothamBold,
					Vector2.new(
						titleWidth,
						18
					)
				)
			end)

		if success
			and bounds
			and bounds.X <= titleWidth
		then
			selectedSize = textSize
			break
		end
	end

	Title.TextSize = selectedSize
end

updateUsernameDisplay()

connect(
	Player:GetPropertyChangedSignal("Name"),
	updateUsernameDisplay
)

