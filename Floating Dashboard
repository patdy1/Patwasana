local function connect(signal, callback)
	if State.Destroyed then
		return nil
	end

	local connection = signal:Connect(callback)
	table.insert(Connections, connection)

	return connection
end

local function disconnectCameraViewport()
	if CameraViewportConnection then
		if CameraViewportConnection.Connected then
			CameraViewportConnection:Disconnect()
		end

		CameraViewportConnection = nil
	end
end

local function disconnectAll()
	for _, connection in ipairs(Connections) do
		if connection and connection.Connected then
			connection:Disconnect()
		end
	end

	table.clear(Connections)
end

local function stopTween(object)
	local entry = ActiveTweens[object]

	if not entry then
		return
	end

	if entry.Connection and entry.Connection.Connected then
		entry.Connection:Disconnect()
	end

	if entry.Tween then
		entry.Tween:Cancel()
	end

	ActiveTweens[object] = nil
end

local function playTween(object, properties, duration)
	stopTween(object)

	local tweenObject = TweenService:Create(
		object,
		TweenInfo.new(
			duration or CONFIG.TweenTime,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		properties
	)

	local entry = {
		Tween = tweenObject,
		Connection = nil,
	}

	ActiveTweens[object] = entry

	entry.Connection = tweenObject.Completed:Connect(function()
		local current = ActiveTweens[object]

		if current == entry then
			ActiveTweens[object] = nil
		end

		if entry.Connection and entry.Connection.Connected then
			entry.Connection:Disconnect()
		end
	end)

	tweenObject:Play()

	return tweenObject
end

local function cancelAllTweens()
	for object, entry in pairs(ActiveTweens) do
		if entry then
			if entry.Connection and entry.Connection.Connected then
				entry.Connection:Disconnect()
			end

			if entry.Tween then
				entry.Tween:Cancel()
			end
		end

		ActiveTweens[object] = nil
	end
end

