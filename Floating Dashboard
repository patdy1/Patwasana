local function setCollapsed(value)
	if State.Destroyed then
		return
	end

	if State.Collapsed == value then
		return
	end

	AnimationToken += 1

	local token =
		AnimationToken

	State.Collapsed =
		value

	stopTween(Main)

	if value then
		Collapse.Text = "+"

		setDashboardBodyVisible(false)

		local tween =
			playTween(
				Main,
				{
					Size =
						UDim2.fromOffset(
							CONFIG.Width,
							CONFIG.CollapsedHeight
						)
				},
				CONFIG.CollapseTweenTime,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.InOut
			)

		waitForTween(
			tween,
			function()
				if token ~= AnimationToken then
					return
				end

				if not State.Collapsed then
					return
				end

				setDashboardBodyVisible(false)
				clampCurrentPosition()
			end
		)
	else
		Collapse.Text = "—"

		setDashboardBodyVisible(false)

		local tween =
			playTween(
				Main,
				{
					Size =
						UDim2.fromOffset(
							CONFIG.Width,
							LAYOUT.ExpandedHeight
						)
				},
				CONFIG.CollapseTweenTime,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.InOut
			)

		waitForTween(
			tween,
			function()
				if token ~= AnimationToken then
					return
				end

				if State.Collapsed then
					return
				end

				if not ScreenGui.Parent then
					return
				end

				setDashboardBodyVisible(true)

				updateContentCanvasSize()
				updateScrollIndicator()

				clampCurrentPosition()
			end
		)
	end
end

