--==================================================
-- DRAG CLAMP
--==================================================

local function clampPosition(position)
	local camera = State.CurrentCamera

	if not camera then
		return position
	end

	local viewport = camera.ViewportSize

	local scale = UIScale.Scale

	local currentHeight =
		State.Collapsed
		and CONFIG.CollapsedHeight
		or CONFIG.Height

	local width =
		CONFIG.Width * scale

	local height =
		currentHeight * scale

	local padding =
		CONFIG.ScreenPadding

	local maxX = math.max(
		padding,
		viewport.X - width - padding
	)

	local maxY = math.max(
		padding,
		viewport.Y - height - padding
	)

	return UDim2.fromOffset(
		math.clamp(
			position.X.Offset,
			padding,
			maxX
		),
		math.clamp(
			position.Y.Offset,
			padding,
			maxY
		)
	)
end

local function clampCurrentPosition()
	if State.Destroyed then
		return
	end

	Main.Position =
		clampPosition(
			Main.Position
		)
end

--==================================================
-- DRAG SYSTEM
--==================================================

local function beginDrag(input)
	if State.Destroyed
		or State.ConfirmVisible then
		return
	end

	if input.UserInputType
		~= Enum.UserInputType.MouseButton1
		and input.UserInputType
		~= Enum.UserInputType.Touch then
		return
	end

	State.Dragging = true
	State.ActiveDragInput = input

	State.DragStart = input.Position
	State.StartPosition = Main.Position
end

local function updateDrag(input)
	if not State.Dragging
		or State.Destroyed
		or not State.DragStart
		or not State.StartPosition then
		return
	end

	local delta =
		input.Position - State.DragStart

	local newPosition =
		UDim2.fromOffset(
			State.StartPosition.X.Offset + delta.X,
			State.StartPosition.Y.Offset + delta.Y
		)

	Main.Position =
		clampPosition(newPosition)
end

local function endDrag(input)
	if not State.Dragging then
		return
	end

	if input == State.ActiveDragInput
		or input.UserInputType
		== Enum.UserInputType.MouseButton1
		or input.UserInputType
		== Enum.UserInputType.Touch then

		State.Dragging = false
		State.ActiveDragInput = nil
		State.DragStart = nil
		State.StartPosition = nil

		clampCurrentPosition()
	end
end

connect(
	DragArea.InputBegan,
	beginDrag
)

connect(
	DragArea.InputChanged,
	function(input)
		if input.UserInputType
			== Enum.UserInputType.MouseMovement
			or input.UserInputType
			== Enum.UserInputType.Touch then

			State.ActiveDragInput = input
		end
	end
)

connect(
	UserInputService.InputChanged,
	function(input)
		if State.Destroyed then
			return
		end

		if input.UserInputType
			== Enum.UserInputType.MouseMovement
			or input.UserInputType
			== Enum.UserInputType.Touch then

			if State.Dragging then
				updateDrag(input)
			end
		end
	end
)

connect(
	UserInputService.InputEnded,
	function(input)
		endDrag(input)
	end
)

--==================================================
-- RESPONSIVE SCALE
--==================================================

local function getResponsiveScale(viewportWidth)
	if viewportWidth <= 380 then
		return CONFIG.MobileScale
	elseif viewportWidth <= 500 then
		return CONFIG.SmallScale
	elseif viewportWidth <= 800 then
		return CONFIG.TabletScale
	else
		return CONFIG.DesktopScale
	end
end

local function updateScale()
	if State.Destroyed then
		return
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	State.CurrentCamera = camera

	local viewport =
		camera.ViewportSize

	local targetScale =
		getResponsiveScale(
			viewport.X
		)

	if math.abs(
		UIScale.Scale - targetScale
	) > 0.001 then

		UIScale.Scale =
			targetScale
	end

	clampCurrentPosition()
end

local function bindCamera(camera)
	if State.Destroyed then
		return
	end

	State.CurrentCamera = camera

	if not camera then
		return
	end

	connect(
		camera:GetPropertyChangedSignal(
			"ViewportSize"
		),
		updateScale
	)

	updateScale()
end

