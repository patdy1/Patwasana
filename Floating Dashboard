local function getButtonColor(
	button
)

	local state =
		ButtonStates[button]

	if not state then
		return CONFIG.ButtonColor
	end

	if state.Pressed then
		return CONFIG.ButtonPressedColor
	end

	if state.Hovered then
		return CONFIG.ButtonHoverColor
	end

	return CONFIG.ButtonColor
end

local function getButtonScale(
	button
)

	local state =
		ButtonStates[button]

	if not state then
		return 1
	end

	if state.Pressed then
		return 0.93
	end

	if state.Hovered then
		return 1.04
	end

	return 1
end

local function updateButtonVisual(
	button
)

	if State.Destroyed then
		return
	end

	if not button
		or not button.Parent then

		return
	end

	playTween(
		button,
		{
			BackgroundColor3 =
				getButtonColor(
					button
				)
		},
		CONFIG.FastTweenTime
	)

	local scale =
		ButtonScales[button]

	if scale then

		playTween(
			scale,
			{
				Scale =
					getButtonScale(
						button
					)
			},
			CONFIG.FastTweenTime
		)
	end
end

local function setupButton(
	button
)

	if not button then
		return
	end

	ButtonStates[button] = {
		Hovered = false,
		Pressed = false,
	}

	connect(
		button.MouseEnter,
		function()

			local state =
				ButtonStates[button]

			if not state then
				return
			end

			state.Hovered = true

			updateButtonVisual(
				button
			)
		end
	)

	connect(
		button.MouseLeave,
		function()

			local state =
				ButtonStates[button]

			if not state then
				return
			end

			state.Hovered = false

			updateButtonVisual(
				button
			)
		end
	)

	connect(
		button.InputBegan,
		function(input)

			local inputType =
				input.UserInputType

			if inputType
				~= Enum.UserInputType.MouseButton1
				and inputType
				~= Enum.UserInputType.Touch then

				return
			end

			local state =
				ButtonStates[button]

			if not state then
				return
			end

			state.Pressed = true

			updateButtonVisual(
				button
			)
		end
	)

	connect(
		button.InputEnded,
		function(input)

			local inputType =
				input.UserInputType

			if inputType
				~= Enum.UserInputType.MouseButton1
				and inputType
				~= Enum.UserInputType.Touch then

				return
			end

			local state =
				ButtonStates[button]

			if not state then
				return
			end

			state.Pressed = false

			updateButtonVisual(
				button
			)
		end
	)

	connect(
		button.Destroying,
		function()

			ButtonStates[button] =
				nil

			local scale =
				ButtonScales[button]

			if scale then
				stopTween(scale)
			end

			ButtonScales[button] =
				nil

			stopTween(button)
		end
	)
end

