--========================================================--
-- DRAG WINDOW
--========================================================--

local Dragging = false
local DragStart
local StartPosition

Header.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		Dragging = true

		DragStart = input.Position

		StartPosition = Main.Position

	end

end)

Header.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		Dragging = false

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if not Dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local Delta = input.Position - DragStart

	Main.Position = UDim2.new(

		StartPosition.X.Scale,

		StartPosition.X.Offset + Delta.X,

		StartPosition.Y.Scale,

		StartPosition.Y.Offset + Delta.Y

	)

end)

--========================================================--
-- MAIN UPDATE LOOP
--========================================================--

local CollisionTimer = 0

RunService.Heartbeat:Connect(function(deltaTime)

	-- Water
	if WalkOnWaterEnabled
		and RootPart
		and WaterPlatform then

		if IsWaterBelow() then

			WaterPlatform.CFrame =
				CFrame.new(
					RootPart.Position.X,
					RootPart.Position.Y + CONFIG.WaterPlatformOffset,
					RootPart.Position.Z
				)

		else

			WaterPlatform.CFrame =
				CFrame.new(
					RootPart.Position.X,
					-1000,
					RootPart.Position.Z
				)

		end

	end

	-- No Collision
	if NoCollisionEnabled then

		CollisionTimer += deltaTime

		if CollisionTimer >= 0.15 then

			CollisionTimer = 0

			UpdateNoCollision()

		end

	end

	-- Speed display
	if Humanoid then

		SpeedText.Text =
			"Fly Speed: "
			.. tostring(math.floor(GetMapSpeed()))

	end

end)

