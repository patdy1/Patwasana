local function disconnectConnection(connection)
	if connection and connection.Connected then
		connection:Disconnect()
	end
end

local function addConnection(connection)
	if not connection then
		return nil
	end

	if State.Destroyed then
		disconnectConnection(connection)
		return nil
	end

	table.insert(Connections, connection)

	return connection
end

local function connect(signal, callback)
	if State.Destroyed or not signal then
		return nil
	end

	return addConnection(signal:Connect(callback))
end

local function disconnectAll()
	for index = #Connections, 1, -1 do
		disconnectConnection(Connections[index])
		Connections[index] = nil
	end
end

local function disconnectCameraViewport()
	if CameraViewportConnection then
		disconnectConnection(CameraViewportConnection)
		CameraViewportConnection = nil
	end
end

local function stopTween(object)
	if not object then
		return
	end

	local entry = ActiveTweens[object]

	if not entry then
		return
	end

	if entry.Connection then
		disconnectConnection(entry.Connection)
		entry.Connection = nil
	end

	if entry.Tween then
		entry.Tween:Cancel()
		entry.Tween = nil
	end

	ActiveTweens[object] = nil
end

local function playTween(
	object,
	properties,
	duration,
	easingStyle,
	easingDirection
)
	if State.Destroyed then
		return nil
	end

	if not object or not object.Parent then
		return nil
	end

	stopTween(object)

	local success, tween = pcall(function()
		return TweenService:Create(
			object,
			TweenInfo.new(
				duration or CONFIG.TweenTime,
				easingStyle or Enum.EasingStyle.Quart,
				easingDirection or Enum.EasingDirection.Out
			),
			properties
		)
	end)

	if not success or not tween then
		return nil
	end

	local entry = {
		Tween = tween,
		Connection = nil,
	}

	ActiveTweens[object] = entry

	entry.Connection = tween.Completed:Connect(function()
		local current = ActiveTweens[object]

		if current ~= entry then
			return
		end

		if entry.Connection then
			disconnectConnection(entry.Connection)
			entry.Connection = nil
		end

		ActiveTweens[object] = nil
	end)

	tween:Play()

	return tween
end

local function waitForTween(tween, callback)
	if not tween or State.Destroyed then
		return
	end

	local connection

	connection = tween.Completed:Connect(function(playbackState)
		if connection then
			disconnectConnection(connection)
			connection = nil
		end

		if State.Destroyed then
			return
		end

		if playbackState ~= Enum.PlaybackState.Completed then
			return
		end

		if callback then
			callback()
		end
	end)
end

local function cancelAllTweens()
	for object, entry in pairs(ActiveTweens) do
		if entry then
			if entry.Connection then
				disconnectConnection(entry.Connection)
				entry.Connection = nil
			end

			if entry.Tween then
				entry.Tween:Cancel()
				entry.Tween = nil
			end
		end

		ActiveTweens[object] = nil
	end
end

