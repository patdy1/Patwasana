--//==================================================
--// NETWORK / PERFORMANCE
--//==================================================

local function getPingState(
	ping
)

	if ping <= 50 then
		return CONFIG.GoodColor,
			"EXCELLENT"

	elseif ping <= 100 then
		return CONFIG.WarningColor,
			"GOOD"

	elseif ping <= 200 then
		return CONFIG.HighColor,
			"HIGH"

	else
		return CONFIG.BadColor,
			"VERY HIGH"
	end
end

local function getPing()

	if State.Destroyed then
		return nil
	end

	local success, seconds =
		pcall(
			function()
				return Player:GetNetworkPing()
			end
		)

	if not success then
		return nil
	end

	if typeof(seconds)
		~= "number" then

		return nil
	end

	if seconds < 0
		or seconds ~= seconds then

		return nil
	end

	return math.floor(
		seconds * 1000
			+ 0.5
	)
end

--//==================================================
--// FPS
--//==================================================

local function updateFPS(
	deltaTime
)

	if State.Destroyed then
		return
	end

	if typeof(deltaTime)
		~= "number" then

		return
	end

	State.FrameCounter += 1

	State.FPSTimer +=
		math.clamp(
			deltaTime,
			0,
			1
		)

	if State.FPSTimer
		< CONFIG.FPSSampleRate then

		return
	end

	State.FPS =
		math.max(
			1,
			math.floor(
				State.FrameCounter
					/ State.FPSTimer
					+ 0.5
			)
		)

	State.FrameCounter = 0
	State.FPSTimer = 0
end

local function getFPSColor(
	fps
)

	if fps >= 55 then
		return CONFIG.GoodColor

	elseif fps >= 30 then
		return CONFIG.WarningColor

	else
		return CONFIG.BadColor
	end
end

