local function CreateToggle(
	name,
	description,
	defaultState,
	callback
)

	local Button = Create("TextButton", {

		Name = name,

		Size = UDim2.new(1, 0, 0, 58),

		BackgroundColor3 = CONFIG.Panel,

		BorderSizePixel = 0,

		AutoButtonColor = false,

		Text = "",

	}, Content)

	AddCorner(Button, 11)
	AddStroke(Button)

	local NameLabel = Create("TextLabel", {

		Name = "Name",

		Size = UDim2.new(1, -85, 0, 22),

		Position = UDim2.fromOffset(13, 8),

		BackgroundTransparency = 1,

		Text = name,

		TextColor3 = CONFIG.Text,

		TextSize = 14,

		Font = Enum.Font.GothamMedium,

		TextXAlignment = Enum.TextXAlignment.Left,

	}, Button)

	local DescriptionLabel = Create("TextLabel", {

		Name = "Description",

		Size = UDim2.new(1, -85, 0, 18),

		Position = UDim2.fromOffset(13, 30),

		BackgroundTransparency = 1,

		Text = description,

		TextColor3 = CONFIG.SubText,

		TextSize = 10,

		Font = Enum.Font.Gotham,

		TextXAlignment = Enum.TextXAlignment.Left,

	}, Button)

	local Status = Create("TextLabel", {

		Name = "Status",

		Size = UDim2.fromOffset(58, 29),

		Position = UDim2.new(1, -69, 0.5, -14),

		BackgroundColor3 = CONFIG.Off,

		BorderSizePixel = 0,

		Text = "OFF",

		TextColor3 = CONFIG.Text,

		TextSize = 10,

		Font = Enum.Font.GothamBold,

	}, Button)

	AddCorner(Status, 8)

	local Enabled = defaultState

	local function Refresh()

		if Enabled then

			Status.Text = "ON"

			Status.BackgroundColor3 = CONFIG.On

			Button.BackgroundColor3 =
				Color3.fromRGB(35, 39, 39)

		else

			Status.Text = "OFF"

			Status.BackgroundColor3 = CONFIG.Off

			Button.BackgroundColor3 = CONFIG.Panel

		end

	end

	Button.MouseButton1Click:Connect(function()

		Enabled = not Enabled

		Refresh()

		callback(Enabled)

	end)

	Refresh()

	return {

		Button = Button,

		Set = function(value)

			Enabled = value

			Refresh()

			callback(Enabled)

		end,

		Get = function()

			return Enabled

		end,

	}

end

