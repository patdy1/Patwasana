--==================================================
-- PING STATE
--==================================================

local function getPingState(ping)
	if ping <= 50 then
		return CONFIG.GoodColor, "EXCELLENT"
	elseif ping <= 100 then
		return CONFIG.WarningColor, "GOOD"
	elseif ping <= 200 then
		return CONFIG.HighColor, "HIGH"
	else
		return CONFIG.BadColor, "VERY HIGH"
	end
end

--==================================================
-- REAL PING
--==================================================

local function getPing()
	local success, result = pcall(function()
		local seconds = Player:GetNetworkPing()

		if typeof(seconds) ~= "number" then
			return nil
		end

		if seconds < 0 then
			return nil
		end

		return math.floor(
			seconds * 1000 + 0.5
		)
	end)

	if success then
		return result
	end

	return nil
end

--==================================================
-- FPS SAMPLING
--==================================================

local function updateFPS(deltaTime)
	if State.Destroyed then
		return
	end

	State.FrameCounter += 1
	State.FPSTimer += deltaTime

	if State.FPSTimer >= CONFIG.FPSSampleRate then
		State.FPS = math.max(
			1,
			math.floor(
				State.FrameCounter / State.FPSTimer + 0.5
			)
		)

		State.FrameCounter = 0
		State.FPSTimer = 0
	end
end

--==================================================
-- FPS COLOR
--==================================================

local function getFPSColor(value)
	if value >= 55 then
		return CONFIG.GoodColor
	elseif value >= 30 then
		return CONFIG.WarningColor
	else
		return CONFIG.BadColor
	end
end

--==================================================
-- UPDATE PING
--==================================================

local function updatePing(ping)
	if ping == State.LastPing then
		return
	end

	State.LastPing = ping

	if ping then
		local color, status = getPingState(ping)

		PingValue.Text =
			string.format("%d ms", ping)

		PingValue.TextColor3 = color

		StatusDot.BackgroundColor3 = color

		StatusText.Text =
			string.format(
				"CONNECTED  •  %d ms  •  %s",
				ping,
				status
			)

		ConnectionValue.Text = "CONNECTED"
		ConnectionValue.TextColor3 =
			CONFIG.GoodColor

		State.LastConnectionState = true
	else
		PingValue.Text = "-- ms"
		PingValue.TextColor3 =
			CONFIG.TextColor

		StatusDot.BackgroundColor3 =
			CONFIG.NeutralColor

		StatusText.Text =
			"NETWORK UNAVAILABLE"

		ConnectionValue.Text =
			"UNAVAILABLE"

		ConnectionValue.TextColor3 =
			CONFIG.NeutralColor

		State.LastConnectionState = false
	end
end

--==================================================
-- UPDATE FPS UI
--==================================================

local function updateFPSUI()
	if State.FPS == State.LastFPS then
		return
	end

	State.LastFPS = State.FPS

	FPSValue.Text =
		tostring(State.FPS)

	FPSValue.TextColor3 =
		getFPSColor(State.FPS)
end

--==================================================
-- UPDATE PLAYERS UI
--==================================================

local function updatePlayers()
	local count = #Players:GetPlayers()
	local maxPlayers = Players.MaxPlayers

	if count == State.LastPlayerCount then
		return
	end

	State.LastPlayerCount = count

	PlayersValue.Text =
		string.format(
			"%d / %d",
			count,
			maxPlayers
		)
end

--==================================================
-- MAIN DATA UPDATE
--==================================================

local function updateDashboard()
	if State.Destroyed or not ScreenGui.Parent then
		return
	end

	updatePing(
		getPing()
	)

	updateFPSUI()

	updatePlayers()
end

