local function setCollapsed(value)
	if State.Destroyed then
		return
	end

	State.Collapsed = value

	if value then
		Content.Visible = false

		Collapse.Text = "+"

		playTween(
			Main,
			{
				Size = UDim2.fromOffset(
					CONFIG.Width,
					CONFIG.CollapsedHeight
				)
			},
			CONFIG.CollapseTweenTime
		)
	else
		Collapse.Text = "—"

		playTween(
			Main,
			{
				Size = UDim2.fromOffset(
					CONFIG.Width,
					CONFIG.Height
				)
			},
			CONFIG.CollapseTweenTime
		)

		task.delay(
			CONFIG.CollapseTweenTime * 0.65,
			function()
				if State.Destroyed then
					return
				end

				if not State.Collapsed
					and ScreenGui.Parent then
					Content.Visible = true
				end
			end
		)
	end
end

