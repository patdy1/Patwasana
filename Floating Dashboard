--==============================================================
-- HELPER: CORNER
--==============================================================

local function addCorner(parent, radius)

	local Corner = Instance.new("UICorner")

	Corner.Name = "Corner"
	Corner.CornerRadius = UDim.new(0, radius)

	Corner.Parent = parent

	return Corner

end

--==============================================================
-- HELPER: STROKE
--==============================================================

local function addStroke(parent, transparency, thickness)

	local Stroke = Instance.new("UIStroke")

	Stroke.Name = "Border"

	Stroke.Color = CONFIG.DividerColor
	Stroke.Transparency = transparency or CONFIG.DividerTransparency
	Stroke.Thickness = thickness or 1

	Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	Stroke.Parent = parent

	return Stroke

end

--==============================================================
-- HELPER: TWEEN
--==============================================================

local function tween(object, properties, duration)

	local Tween = TweenService:Create(

		object,

		TweenInfo.new(
			duration or 0.12,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),

		properties

	)

	Tween:Play()

	return Tween

end

--==============================================================
-- HELPER: LABEL
--==============================================================

local function createLabel(
	parent,
	text,
	size,
	position,
	fontSize,
	font,
	color
)

	local Label = Instance.new("TextLabel")

	Label.BackgroundTransparency = 1
	Label.BorderSizePixel = 0

	Label.Text = text

	Label.TextColor3 = color or CONFIG.TextColor

	Label.TextSize = fontSize or 12

	Label.Font = font or Enum.Font.Gotham

	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.TextYAlignment = Enum.TextYAlignment.Center

	Label.TextTruncate = Enum.TextTruncate.AtEnd

	Label.Size = size
	Label.Position = position

	Label.Parent = parent

	return Label

end

