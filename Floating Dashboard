--==============================================================
-- SCROLL METRICS
--==============================================================

local function getScrollMetrics()
	if State.Destroyed then
		return nil
	end

	if not Content
		or not Content.Parent
	then
		return nil
	end

	local visibleHeight =
		Content.AbsoluteSize.Y

	local contentHeight =
		math.max(
			Content.AbsoluteCanvasSize.Y,
			0
		)

	local currentScroll =
		math.max(
			Content.CanvasPosition.Y,
			0
		)

	local maximumScroll =
		math.max(
			contentHeight - visibleHeight,
			0
		)

	return {
		VisibleHeight = visibleHeight,
		ContentHeight = contentHeight,
		CurrentScroll = currentScroll,
		MaximumScroll = maximumScroll,
	}
end

local function updateScrollIndicator()
	if State.Destroyed then
		return
	end

	if not Content
		or not Content.Parent
		or not ScrollIndicator
		or not ScrollIndicator.Parent
	then
		return
	end

	local metrics =
		getScrollMetrics()

	if not metrics then
		return
	end

	local visibleHeight =
		metrics.VisibleHeight

	local contentHeight =
		metrics.ContentHeight

	local currentScroll =
		metrics.CurrentScroll

	local maximumScroll =
		metrics.MaximumScroll

	-- No overflow = no indicator.
	if visibleHeight <= 0
		or contentHeight <= visibleHeight + 0.01
		or maximumScroll <= 0.01
	then
		ScrollIndicator.Visible = false
		return
	end

	local trackWidth =
		math.max(
			Content.AbsoluteSize.X
				- (
					CONFIG.ScrollIndicatorSidePadding
					* 2
				),
			1
		)

	-- True proportional indicator size:
	--
	-- visible area / total content area
	--
	-- The indicator is never allowed to become smaller
	-- than the configured visual minimum.
	local proportionalWidth =
		trackWidth
		* (
			visibleHeight
			/ contentHeight
		)

	local indicatorWidth =
		math.clamp(
			proportionalWidth,
			CONFIG.ScrollIndicatorMinimumWidth,
			trackWidth
		)

	local movableRange =
		math.max(
			trackWidth
				- indicatorWidth,
			0
		)

	local scrollRatio =
		math.clamp(
			currentScroll
				/ maximumScroll,
			0,
			1
		)

	local indicatorOffset =
		movableRange
		* scrollRatio

	ScrollIndicator.Size =
		UDim2.fromOffset(
			indicatorWidth,
			CONFIG.ScrollIndicatorHeight
		)

	ScrollIndicator.Position =
		UDim2.new(
			0,
			CONFIG.ScrollIndicatorSidePadding
				+ indicatorOffset,
			1,
			-CONFIG.ScrollIndicatorBottomPadding
		)

	ScrollIndicator.Visible = true
end

local function queueScrollIndicatorUpdate()
	if State.Destroyed then
		return
	end

	if State.ScrollUpdateQueued then
		return
	end

	State.ScrollUpdateQueued = true

	task.defer(function()
		State.ScrollUpdateQueued = false

		if State.Destroyed then
			return
		end

		updateScrollIndicator()
	end)
end

