--========================================================--
-- WATER SYSTEM
--========================================================--

local WaterPlatform

local function DestroyWaterPlatform()

	if WaterPlatform then

		WaterPlatform:Destroy()

		WaterPlatform = nil

	end

end

function CreateWaterPlatform()

	if not Character or not RootPart then
		return
	end

	DestroyWaterPlatform()

	WaterPlatform = Instance.new("Part")

	WaterPlatform.Name = "LocalWaterPlatform"

	WaterPlatform.Size = CONFIG.WaterPlatformSize

	WaterPlatform.Anchored = true

	WaterPlatform.CanCollide = true

	WaterPlatform.CanTouch = false

	WaterPlatform.CanQuery = false

	WaterPlatform.Transparency = 1

	WaterPlatform.CastShadow = false

	WaterPlatform.Parent = Workspace

end

local function IsWaterBelow()

	if not RootPart then
		return false
	end

	local Origin = RootPart.Position + Vector3.new(0, 2, 0)

	local Direction = Vector3.new(0, -12, 0)

	local Params = RaycastParams.new()

	Params.FilterType = Enum.RaycastFilterType.Exclude

	Params.FilterDescendantsInstances = {
		Character,
		WaterPlatform
	}

	local Result = Workspace:Raycast(
		Origin,
		Direction,
		Params
	)

	if not Result then
		return false
	end

	return Result.Material == Enum.Material.Water

end

--========================================================--
-- NO COLLISION
--========================================================--

local OriginalCollision = {}

local function SaveCollision(part)

	if OriginalCollision[part] == nil then

		OriginalCollision[part] = part.CanCollide

	end

end

local function RestoreCollision()

	for part, originalValue in pairs(OriginalCollision) do

		if part and part.Parent then

			part.CanCollide = originalValue

		end

	end

	table.clear(OriginalCollision)

end

local function UpdateNoCollision()

	if not NoCollisionEnabled then

		RestoreCollision()

		return

	end

	if not RootPart then
		return
	end

	local OverlapParams = OverlapParams.new()

	OverlapParams.FilterType = Enum.RaycastFilterType.Exclude

	OverlapParams.FilterDescendantsInstances = {
		Character,
		WaterPlatform
	}

	local Parts = Workspace:GetPartBoundsInRadius(
		RootPart.Position,
		CONFIG.NoCollisionDistance,
		OverlapParams
	)

	for _, part in ipairs(Parts) do

		if part:IsA("BasePart")
			and part.Parent
			and not part:IsDescendantOf(Character)
			and part ~= WaterPlatform then

			SaveCollision(part)

			-- Don't disable terrain-like floor parts.
			-- Parts positioned underneath the player remain collidable.
			local relativeY = part.Position.Y - RootPart.Position.Y

			if relativeY > -4 then

				part.CanCollide = false

			end

		end

	end

end

--========================================================--
-- FLY SYSTEM
--========================================================--

local FlyConnection

local BodyVelocity
local BodyGyro

local FlyingKeys = {

	W = false,
	A = false,
	S = false,
	D = false,
	Space = false,
	Shift = false,

}

local function DestroyFlyObjects()

	if FlyConnection then

		FlyConnection:Disconnect()

		FlyConnection = nil

	end

	if BodyVelocity then

		BodyVelocity:Destroy()

		BodyVelocity = nil

	end

	if BodyGyro then

		BodyGyro:Destroy()

		BodyGyro = nil

	end

	if Humanoid then

		Humanoid.AutoRotate = true

	end

end

local function GetMapSpeed()

	if not Humanoid then
		return 16
	end

	return math.max(
		Humanoid.WalkSpeed * CONFIG.FlyMultiplier,
		1
	)

end

local function StartFly()

	if not Character or not RootPart or not Humanoid then
		return
	end

	DestroyFlyObjects()

	Humanoid.AutoRotate = false

	BodyVelocity = Instance.new("BodyVelocity")

	BodyVelocity.Name = "MovementFlyVelocity"

	BodyVelocity.MaxForce = Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)

	BodyVelocity.P = 10000

	BodyVelocity.Velocity = Vector3.zero

	BodyVelocity.Parent = RootPart

	BodyGyro = Instance.new("BodyGyro")

	BodyGyro.Name = "MovementFlyGyro"

	BodyGyro.MaxTorque = Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)

	BodyGyro.P = 10000

	BodyGyro.CFrame = RootPart.CFrame

	BodyGyro.Parent = RootPart

	FlyConnection = RunService.RenderStepped:Connect(function()

		if not FlyEnabled then
			return
		end

		if not RootPart or not RootPart.Parent then
			return
		end

		local Camera = Workspace.CurrentCamera

		if not Camera then
			return
		end

		local MoveDirection = Vector3.zero

		local Forward = Camera.CFrame.LookVector

		local Right = Camera.CFrame.RightVector

		Forward = Vector3.new(
			Forward.X,
			0,
			Forward.Z
		)

		Right = Vector3.new(
			Right.X,
			0,
			Right.Z
		)

		if Forward.Magnitude > 0 then
			Forward = Forward.Unit
		end

		if Right.Magnitude > 0 then
			Right = Right.Unit
		end

		if FlyingKeys.W then
			MoveDirection += Forward
		end

		if FlyingKeys.S then
			MoveDirection -= Forward
		end

		if FlyingKeys.D then
			MoveDirection += Right
		end

		if FlyingKeys.A then
			MoveDirection -= Right
		end

		if FlyingKeys.Space then
			MoveDirection += Vector3.new(0, 1, 0)
		end

		if FlyingKeys.Shift then
			MoveDirection -= Vector3.new(0, 1, 0)
		end

		if MoveDirection.Magnitude > 0 then

			MoveDirection = MoveDirection.Unit

			BodyVelocity.Velocity =
				MoveDirection * GetMapSpeed()

		else

			BodyVelocity.Velocity = Vector3.zero

		end

		BodyGyro.CFrame = CFrame.lookAt(
			RootPart.Position,
			RootPart.Position + Camera.CFrame.LookVector
		)

	end)

end

local function StopFly()

	DestroyFlyObjects()

end

