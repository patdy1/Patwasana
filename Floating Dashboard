--==============================================================
-- VIEWPORT
--==============================================================

local function getViewportSize()
	if State.Destroyed then
		return Vector2.zero
	end

	local camera =
		workspace.CurrentCamera

	if camera then
		return camera.ViewportSize
	end

	return Vector2.zero
end

local function getResponsiveScale(width)
	if width <= 380 then
		return CONFIG.MobileScale
	elseif width <= 500 then
		return CONFIG.SmallScale
	elseif width <= 800 then
		return CONFIG.TabletScale
	end

	return CONFIG.DesktopScale
end

local function getRenderedMainSize()
	local scale =
		UIScale.Scale

	local height =
		State.Collapsed
		and CONFIG.CollapsedHeight
		or LAYOUT.ExpandedHeight

	return Vector2.new(
		CONFIG.Width * scale,
		height * scale
	)
end

local function getCenterFromPosition(position)
	local viewport =
		getViewportSize()

	return Vector2.new(
		viewport.X * position.X.Scale
			+ position.X.Offset,

		viewport.Y * position.Y.Scale
			+ position.Y.Offset
	)
end

local function positionFromCenter(center)
	local viewport =
		getViewportSize()

	return UDim2.new(
		0.5,
		center.X - viewport.X * 0.5,

		0.5,
		center.Y - viewport.Y * 0.5
	)
end

local function clampPosition(position)
	local viewport =
		getViewportSize()

	if viewport.X <= 0
		or viewport.Y <= 0
	then
		return position
	end

	local renderedSize =
		getRenderedMainSize()

	local halfWidth =
		renderedSize.X * 0.5

	local halfHeight =
		renderedSize.Y * 0.5

	local padding =
		CONFIG.ScreenPadding

	local minX =
		padding + halfWidth

	local maxX =
		viewport.X
		- padding
		- halfWidth

	local minY =
		padding + halfHeight

	local maxY =
		viewport.Y
		- padding
		- halfHeight

	local center =
		getCenterFromPosition(position)

	local clampedX

	if minX > maxX then
		clampedX =
			viewport.X * 0.5
	else
		clampedX =
			math.clamp(
				center.X,
				minX,
				maxX
			)
	end

	local clampedY

	if minY > maxY then
		clampedY =
			viewport.Y * 0.5
	else
		clampedY =
			math.clamp(
				center.Y,
				minY,
				maxY
			)
	end

	return positionFromCenter(
		Vector2.new(
			clampedX,
			clampedY
		)
	)
end

local function clampCurrentPosition()
	if State.Destroyed then
		return
	end

	local clamped =
		clampPosition(
			Main.Position
		)

	Main.Position =
		clamped

	ReopenButton.Position =
		clamped
end

local function centerDashboard()
	if State.Destroyed then
		return
	end

	local viewport =
		getViewportSize()

	if viewport.X <= 0
		or viewport.Y <= 0
	then
		return
	end

	Main.Position =
		positionFromCenter(
			Vector2.new(
				viewport.X * 0.5,
				viewport.Y * 0.5
			)
		)

	ReopenButton.Position =
		Main.Position
end

local function updateScale()
	if State.Destroyed then
		return
	end

	local viewport =
		getViewportSize()

	if viewport.X <= 0 then
		return
	end

	local targetScale =
		getResponsiveScale(
			viewport.X
		)

	if math.abs(
		UIScale.Scale
			- targetScale
	) > 0.001
	then
		UIScale.Scale =
			targetScale
	end

	clampCurrentPosition()
	queueScrollIndicatorUpdate()
end

local function queueViewportUpdate()
	if State.Destroyed then
		return
	end

	if State.ViewportUpdateQueued then
		return
	end

	State.ViewportUpdateQueued = true

	task.defer(function()
		State.ViewportUpdateQueued = false

		if State.Destroyed then
			return
		end

		updateScale()
		updateContentCanvasSize()
		updateScrollIndicator()
	end)
end

local function bindCamera(camera)
	if State.Destroyed then
		return
	end

	disconnectCameraViewport()

	State.CurrentCamera =
		camera

	if not camera then
		queueViewportUpdate()
		return
	end

	CameraViewportConnection =
		camera:GetPropertyChangedSignal(
			"ViewportSize"
		):Connect(function()
			if State.Destroyed then
				return
			end

			queueViewportUpdate()
		end)

	queueViewportUpdate()
end

--==============================================================
-- DRAG
--==============================================================

local function resetDragState()
	State.Dragging = false
	State.DragStart = nil
	State.StartCenter = nil
end

local function beginDrag(input)
	if State.Destroyed then
		return
	end

	if State.ConfirmVisible then
		return
	end

	if not Main.Visible then
		return
	end

	local inputType =
		input.UserInputType

	if inputType
		~= Enum.UserInputType.MouseButton1
		and inputType
		~= Enum.UserInputType.Touch
	then
		return
	end

	State.Dragging = true

	State.DragStart =
		input.Position

	State.StartCenter =
		getCenterFromPosition(
			Main.Position
		)
end

local function updateDrag(input)
	if State.Destroyed
		or not State.Dragging
	then
		return
	end

	if not State.DragStart
		or not State.StartCenter
	then
		return
	end

	local delta =
		input.Position
		- State.DragStart

	local newCenter =
		State.StartCenter
		+ delta

	local newPosition =
		positionFromCenter(
			newCenter
		)

	local clamped =
		clampPosition(
			newPosition
		)

	Main.Position =
		clamped

	ReopenButton.Position =
		clamped
end

local function endDrag(input)
	if not State.Dragging then
		return
	end

	local inputType =
		input.UserInputType

	if inputType
		== Enum.UserInputType.MouseButton1
		or inputType
		== Enum.UserInputType.Touch
	then
		resetDragState()
		clampCurrentPosition()
	end
end

