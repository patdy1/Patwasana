--==============================================================

local function getPingState(ping)
	if ping <= 50 then
		return CONFIG.GoodColor, "EXCELLENT"
	elseif ping <= 100 then
		return CONFIG.WarningColor, "GOOD"
	elseif ping <= 200 then
		return CONFIG.HighColor, "HIGH"
	else
		return CONFIG.BadColor, "VERY HIGH"
	end
end

local function getPing()
	if State.Destroyed then
		return nil
	end

	local success, seconds =
		pcall(function()
			return Player:GetNetworkPing()
		end)

	if not success then
		return nil
	end

	if typeof(seconds) ~= "number" then
		return nil
	end

	if seconds < 0
		or seconds ~= seconds
	then
		return nil
	end

	return math.floor(
		seconds * 1000 + 0.5
	)
end

local function updateFPS(deltaTime)
	if State.Destroyed then
		return
	end

	if typeof(deltaTime) ~= "number" then
		return
	end

	State.FrameCounter += 1

	State.FPSTimer +=
		math.clamp(
			deltaTime,
			0,
			1
		)

	if State.FPSTimer <
		CONFIG.FPSSampleRate
	then
		return
	end

	State.FPS =
		math.max(
			1,
			math.floor(
				State.FrameCounter
					/ State.FPSTimer
					+ 0.5
			)
		)

	State.FrameCounter = 0
	State.FPSTimer = 0
end

local function getFPSColor(fps)
	if fps >= 55 then
		return CONFIG.GoodColor
	elseif fps >= 30 then
		return CONFIG.WarningColor
	else
		return CONFIG.BadColor
	end
end

local function updatePingUI(ping)
	if ping == State.LastPing then
		return
	end

	State.LastPing = ping

	if ping then
		local color, status =
			getPingState(ping)

		PingValue.Text =
			string.format(
				"%d ms",
				ping
			)

		PingValue.TextColor3 =
			color

		StatusDot.BackgroundColor3 =
			color

		StatusText.Text =
			string.format(
				"CONNECTED  •  %d ms  •  %s",
				ping,
				status
			)

		StatusText.TextColor3 =
			color

		ConnectionValue.Text =
			"CONNECTED"

		ConnectionValue.TextColor3 =
			CONFIG.GoodColor

		LiveDot.BackgroundColor3 =
			CONFIG.GoodColor

		LiveText.TextColor3 =
			CONFIG.GoodColor
	else
		PingValue.Text =
			"-- ms"

		PingValue.TextColor3 =
			CONFIG.TextColor

		StatusDot.BackgroundColor3 =
			CONFIG.NeutralColor

		StatusText.Text =
			"NETWORK UNAVAILABLE"

		StatusText.TextColor3 =
			CONFIG.SecondaryTextColor

		ConnectionValue.Text =
			"UNAVAILABLE"

		ConnectionValue.TextColor3 =
			CONFIG.NeutralColor

		LiveDot.BackgroundColor3 =
			CONFIG.NeutralColor

		LiveText.TextColor3 =
			CONFIG.NeutralColor
	end
end

local function updateFPSUI()
	if State.FPS == State.LastFPS then
		return
	end

	State.LastFPS = State.FPS

	if not State.FPS then
		FPSValue.Text = "--"
		FPSValue.TextColor3 =
			CONFIG.TextColor
		return
	end

	FPSValue.Text =
		tostring(State.FPS)

	FPSValue.TextColor3 =
		getFPSColor(State.FPS)
end

local function updatePlayers()
	if State.Destroyed then
		return
	end

	local count =
		#Players:GetPlayers()

	local maxPlayers =
		Players.MaxPlayers

	if count == State.LastPlayerCount
		and maxPlayers == State.LastMaxPlayers
	then
		return
	end

	State.LastPlayerCount =
		count

	State.LastMaxPlayers =
		maxPlayers

	PlayersValue.Text =
		string.format(
			"%d / %d",
			count,
			maxPlayers
		)
end

local function updateDashboard()
	if State.Destroyed then
		return
	end

	if not ScreenGui.Parent then
		return
	end

	updatePingUI(getPing())
	updateFPSUI()
	updatePlayers()
end

