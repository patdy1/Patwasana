	ConfirmOverlay.Visible =
		false

	Main.Visible =
		false

	if CONFIG.ReopenEnabled then

		ReopenButton.Position =
			Main.Position

		ReopenButton.Visible =
			true

	else

		State.Destroyed =
			true

		disconnectCameraViewport()
		cancelAllTweens()
		disconnectAll()

		table.clear(ButtonStates)
		table.clear(ButtonScales)

		if ScreenGui.Parent then
			ScreenGui:Destroy()
		end
	end
end

