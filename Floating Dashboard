		setDashboardBodyVisible(true)
	end

	updateContentCanvasSize()
	updateScrollIndicator()

	clampCurrentPosition()
	queueViewportUpdate()
end

local function destroyDashboard()
	if State.Destroyed then
		return
	end

	State.Destroyed = true
	State.DashboardVisible = false
	State.ConfirmVisible = false

	resetDragState()

	State.CurrentCamera = nil
	State.ViewportUpdateQueued = false
	State.ScrollUpdateQueued = false

	disconnectCameraViewport()
	cancelAllTweens()
	disconnectAll()

	table.clear(ButtonStates)
	table.clear(ButtonScales)

	if ScreenGui.Parent then
		ScreenGui:Destroy()
	end
end

local function hideDashboard()
	if State.Destroyed then
		return
	end

	State.DashboardVisible = false
	State.ConfirmVisible = false

	resetDragState()

	ConfirmOverlay.Visible = false
	Main.Visible = false

	ScrollIndicator.Visible = false

	if CONFIG.ReopenEnabled then
		ReopenButton.Position =
			Main.Position

		ReopenButton.Visible = true
	else
		destroyDashboard()
	end
end

