--//==================================================
--// RESPONSIVE SYSTEM
--//==================================================

local function getViewportSize()

	if State.Destroyed then
		return Vector2.zero
	end

	local camera =
		workspace.CurrentCamera

	if camera then
		return camera.ViewportSize
	end

	return Vector2.zero
end

local function getResponsiveScale(
	width
)

	if width <= 380 then
		return CONFIG.MobileScale

	elseif width <= 500 then
		return CONFIG.SmallScale

	elseif width <= 800 then
		return CONFIG.TabletScale
	end

	return CONFIG.DesktopScale
end

local function getRenderedMainSize()

	local scale =
		UIScale.Scale

	local height =
		State.Collapsed
		and CONFIG.CollapsedHeight
		or CONFIG.Height

	return Vector2.new(
		CONFIG.Width * scale,
		height * scale
	)
end

local function clampPosition(
	position
)

	local viewport =
		getViewportSize()

	if viewport.X <= 0
		or viewport.Y <= 0 then

		return position
	end

	local renderedSize =
		getRenderedMainSize()

	local padding =
		CONFIG.ScreenPadding

	local maxX =
		math.max(
			padding,
			viewport.X
				- renderedSize.X
				- padding
		)

	local maxY =
		math.max(
			padding,
			viewport.Y
				- renderedSize.Y
				- padding
		)

	return UDim2.fromOffset(

		math.clamp(
			position.X.Offset,
			padding,
			maxX
		),

		math.clamp(
			position.Y.Offset,
			padding,
			maxY
		)
	)
end

local function clampCurrentPosition()

	if State.Destroyed then
		return
	end

	local clamped =
		clampPosition(
			Main.Position
		)

	if Main.Position.X.Offset
		~= clamped.X.Offset
		or Main.Position.Y.Offset
		~= clamped.Y.Offset then

		Main.Position =
			clamped
	end

	if ReopenButton.Visible then
		ReopenButton.Position =
			Main.Position
	end
end

local function updateScale()

	if State.Destroyed then
		return
	end

	local viewport =
		getViewportSize()

	if viewport.X <= 0 then
		return
	end

	local targetScale =
		getResponsiveScale(
			viewport.X
		)

	if math.abs(
		UIScale.Scale
			- targetScale
	) > 0.001 then

		UIScale.Scale =
			targetScale
	end

	clampCurrentPosition()
end

local function queueViewportUpdate()

	if State.Destroyed then
		return
	end

	if State.ViewportUpdateQueued then
		return
	end

	State.ViewportUpdateQueued =
		true

	task.defer(
		function()

			State.ViewportUpdateQueued =
				false

			if State.Destroyed then
				return
			end

			updateScale()
		end
	)
end

local function bindCamera(
	camera
)

	if State.Destroyed then
		return
	end

	disconnectCameraViewport()

	State.CurrentCamera =
		camera

	if not camera then
		queueViewportUpdate()
		return
	end

	CameraViewportConnection =
		camera:GetPropertyChangedSignal(
			"ViewportSize"
		):Connect(
			function()

				if State.Destroyed then
					return
				end

				queueViewportUpdate()
			end
		)

	queueViewportUpdate()
end

--//==================================================
--// DRAG SYSTEM
--//==================================================

local function resetDragState()

	State.Dragging = false
	State.DragStart = nil
	State.StartPosition = nil
end

local function beginDrag(
	input
)

	if State.Destroyed then
		return
	end

	if State.ConfirmVisible then
		return
	end

	if not Main.Visible then
		return
	end

	local inputType =
		input.UserInputType

	if inputType
		~= Enum.UserInputType.MouseButton1
		and inputType
		~= Enum.UserInputType.Touch then

		return
	end

	State.Dragging = true
	State.DragStart =
		input.Position

	State.StartPosition =
		Main.Position
end

local function updateDrag(
	input
)

	if State.Destroyed
		or not State.Dragging then

		return
	end

	if not State.DragStart
		or not State.StartPosition then

		return
	end

	local delta =
		input.Position
		- State.DragStart

	local newPosition =
		UDim2.fromOffset(

			State.StartPosition.X.Offset
				+ delta.X,

			State.StartPosition.Y.Offset
				+ delta.Y
		)

	Main.Position =
		clampPosition(
			newPosition
		)
end

local function endDrag(
	input
)

	if not State.Dragging then
		return
	end

	local inputType =
		input.UserInputType

	if inputType
		== Enum.UserInputType.MouseButton1
		or inputType
		== Enum.UserInputType.Touch then

		resetDragState()
		clampCurrentPosition()
	end
end

