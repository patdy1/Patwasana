--==============================================================
-- PING STATUS
--==============================================================

local function getPingStatus(ping)

	if ping <= 50 then

		return CONFIG.GoodColor, "EXCELLENT"

	elseif ping <= 100 then

		return CONFIG.WarningColor, "GOOD"

	elseif ping <= 200 then

		return CONFIG.HighColor, "HIGH"

	else

		return CONFIG.BadColor, "VERY HIGH"

	end

end

--==============================================================
-- GET PING
--==============================================================

local function getPing()

	local success, result = pcall(function()

		local pingSeconds = Player:GetNetworkPing()

		if typeof(pingSeconds) ~= "number" then
			return nil
		end

		return math.floor(
			(pingSeconds * 1000) + 0.5
		)

	end)

	if success then
		return result
	end

	return nil

end

--==============================================================
-- FPS SYSTEM
--==============================================================

local FPS = 60

local FrameCounter = 0
local FPSTimer = 0

RunService.RenderStepped:Connect(function(deltaTime)

	FrameCounter += 1

	FPSTimer += deltaTime

	if FPSTimer >= 0.5 then

		FPS = math.floor(
			(FrameCounter / FPSTimer) + 0.5
		)

		FrameCounter = 0

		FPSTimer = 0

	end

end)

--==============================================================
-- FPS COLOR
--==============================================================

local function getFPSColor(fps)

	if fps >= 55 then

		return CONFIG.GoodColor

	elseif fps >= 30 then

		return CONFIG.WarningColor

	else

		return CONFIG.BadColor

	end

end

--==============================================================
-- REAL-TIME UPDATE
--==============================================================

task.spawn(function()

	while ScreenGui.Parent do

		--======================================================
		-- PING
		--======================================================

		local Ping = getPing()

		if Ping then

			local PingColor, PingStatus =
				getPingStatus(Ping)

			PingValue.Text =
				tostring(Ping) .. " ms"

			PingValue.TextColor3 =
				PingColor

			StatusDot.BackgroundColor3 =
				PingColor

			StatusText.Text =
				"CONNECTED  •  " ..
				tostring(Ping) ..
				" ms  •  " ..
				PingStatus

			StatusText.TextColor3 =
				PingColor

			ConnectionValue.Text =
				"CONNECTED"

			ConnectionValue.TextColor3 =
				CONFIG.GoodColor

		else

			PingValue.Text =
				"-- ms"

			PingValue.TextColor3 =
				CONFIG.NeutralColor

			StatusDot.BackgroundColor3 =
				CONFIG.NeutralColor

			StatusText.Text =
				"CONNECTING..."

			StatusText.TextColor3 =
				CONFIG.SecondaryTextColor

			ConnectionValue.Text =
				"CONNECTING"

			ConnectionValue.TextColor3 =
				CONFIG.WarningColor

		end

		--======================================================
		-- FPS
		--======================================================

		FPSValue.Text =
			tostring(FPS)

		FPSValue.TextColor3 =
			getFPSColor(FPS)

		--======================================================
		-- PLAYERS
		--======================================================

		local CurrentPlayers =
			#Players:GetPlayers()

		local MaxPlayers =
			Players.MaxPlayers

		if MaxPlayers <= 0 then
			MaxPlayers = CurrentPlayers
		end

		PlayersValue.Text =
			tostring(CurrentPlayers) ..
			" / " ..
			tostring(MaxPlayers)

		--======================================================
		-- WAIT
		--======================================================

		task.wait(CONFIG.UpdateRate)

	end

end)

--==============================================================
-- BUTTON EFFECT
--==============================================================

local function setupButton(Button)

	Button.MouseEnter:Connect(function()

		tween(
			Button,
			{
				BackgroundColor3 =
					CONFIG.HoverColor
			},
			CONFIG.HoverTweenTime
		)

	end)

	Button.MouseLeave:Connect(function()

		tween(
			Button,
			{
				BackgroundColor3 =
					CONFIG.ButtonColor
			},
			CONFIG.HoverTweenTime
		)

	end)

	Button.MouseButton1Down:Connect(function()

		tween(
			Button,
			{
				BackgroundColor3 =
					CONFIG.PressedColor
			},
			CONFIG.PressTweenTime
		)

	end)

	Button.MouseButton1Up:Connect(function()

		tween(
			Button,
			{
				BackgroundColor3 =
					CONFIG.HoverColor
			},
			CONFIG.HoverTweenTime
		)

	end)

end

