--==================================================
-- CONNECTION MANAGEMENT
--==================================================

local Connections = {}
local ActiveTweens = {}

local function connect(signal, callback)
	local connection = signal:Connect(callback)

	table.insert(Connections, connection)

	return connection
end

local function disconnectAll()
	for _, connection in ipairs(Connections) do
		if connection and connection.Connected then
			connection:Disconnect()
		end
	end

	table.clear(Connections)
end

--==================================================
-- TWEEN MANAGEMENT
--==================================================

local function stopTween(object)
	local previous = ActiveTweens[object]

	if previous then
		previous:Cancel()
		ActiveTweens[object] = nil
	end
end

local function playTween(object, properties, duration)
	stopTween(object)

	local tweenObject = TweenService:Create(
		object,
		TweenInfo.new(
			duration or CONFIG.TweenTime,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		properties
	)

	ActiveTweens[object] = tweenObject

	tweenObject.Completed:Connect(function()
		if ActiveTweens[object] == tweenObject then
			ActiveTweens[object] = nil
		end
	end)

	tweenObject:Play()

	return tweenObject
end

local function cancelAllTweens()
	for object, tweenObject in pairs(ActiveTweens) do
		if tweenObject then
			tweenObject:Cancel()
		end

		ActiveTweens[object] = nil
	end
end

